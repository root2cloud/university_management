<odoo>
 
<record id="view_prediction_analysis_registration_list" model="ir.ui.view">
    <field name="name">prediction.analysis.registration.list</field>
    <field name="model">prediction.analysis.registration</field>
    <field name="arch" type="xml">
        <list create="0" delete="0">
            <field name="name"/>
            <field name="email"/>
            <field name="contacts"/>
            <field name="uuid"/>
            <field name="status"/>
        </list>
    </field>
</record>
 
<record id="view_prediction_analysis_registration_form" model="ir.ui.view">
        <field name="name">prediction.analysis.registration.form</field>
        <field name="model">prediction.analysis.registration</field>
        <field name="arch" type="xml">
            <form string="Registration" create="false" delete="false">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="email"/>
                        <field name="contacts"/>
                        <field name="uuid" readonly="1"/>
                        <button name="action_regenerate_uuid" string="Regenerate UUID" type="object" class="oe_highlight"/>
                        <field name="status" readonly="1"/>
                        <field name="openai_api_key"/>
                        <button name="action_validate_openai_api_key" string="Validate OpenAI API Key" type="object" class="oe_highlight"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
 