<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_hackathon_judge_list" model="ir.ui.view">
            <field name="name">hackathon.judge.list</field>
            <field name="model">hackathon.judge</field>
            <field name="arch" type="xml">
                <list string="Judges" sample="1">
                    <field name="name"/>
                    <field name="designation"/>
                    <field name="organization"/>
                    <field name="expertise"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_hackathon_judge_form" model="ir.ui.view">
            <field name="name">hackathon.judge.form</field>
            <field name="model">hackathon.judge</field>
            <field name="arch" type="xml">
                <form string="Judge">
                    <sheet>
                        <field name="image" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <label for="name" string="Judge Name"/>
                            <h1>
                                <field name="name" placeholder="Enter judge name"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Contact Information">
                                <field name="email"/>
                                <field name="phone"/>
                                <field name="linkedin_profile"/>
                            </group>
                            <group string="Professional Details">
                                <field name="designation"/>
                                <field name="organization"/>
                                <field name="experience_years"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <group string="Judging Criteria Weights (Must total 100%)">
                            <group>
                                <field name="innovation_weight"/>
                                <field name="technical_weight"/>
                            </group>
                            <group>
                                <field name="impact_weight"/>
                                <field name="presentation_weight"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Expertise &amp; Biography">
                                <group>
                                    <field name="expertise" widget="text"/>
                                    <field name="bio" widget="html"/>
                                </group>
                            </page>
                            <page string="Scoring History">
                                <field name="scoring_ids">
                                    <list>
                                        <field name="submission_id"/>
                                        <field name="innovation_score"/>
                                        <field name="technical_score"/>
                                        <field name="impact_score"/>
                                        <field name="presentation_score"/>
                                        <field name="total_score"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_hackathon_judge" model="ir.actions.act_window">
            <field name="name">Judges</field>
            <field name="res_model">hackathon.judge</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>