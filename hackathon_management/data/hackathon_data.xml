<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Sequences -->
        <record id="sequence_hackathon_event" model="ir.sequence">
            <field name="name">Hackathon Event Sequence</field>
            <field name="code">hackathon.event</field>
            <field name="prefix">HACK-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="sequence_hackathon_team" model="ir.sequence">
            <field name="name">Hackathon Team Sequence</field>
            <field name="code">hackathon.team</field>
            <field name="prefix">TEAM-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

    </data>
</odoo>