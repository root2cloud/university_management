<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_naac_activity" model="ir.actions.report">
        <field name="name">NAAC Department Activity Report</field>
        <field name="model">naac.department.activity</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">university_management.report_naac_activity_template</field>
        <field name="report_file">university_management.report_naac_activity_template</field>
        <field name="binding_model_id" ref="model_naac_department_activity"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_naac_activity_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center mb-4 border-bottom pb-3">
                            <h3>NAAC DEPARTMENT ACTIVITY REPORT</h3>
                            <p class="text-muted">National Assessment and Accreditation Council</p>
                        </div>

                        <table class="table table-bordered mb-4">
                            <tr>
                                <th class="bg-light" style="width:30%">Reference No.</th>
                                <td><t t-esc="doc.reference"/></td>
                            </tr>
                            <tr>
                                <th class="bg-light">Activity Title</th>
                                <td><t t-esc="doc.name"/></td>
                            </tr>
                            <tr>
                                <th class="bg-light">Department</th>
                                <td><t t-esc="doc.department_id.name"/></td>
                            </tr>
                            <tr>
                                <th class="bg-light">NAAC Criterion</th>
                                <td><t t-esc="doc.criterion_id.display_name"/></td>
                            </tr>
                            <tr>
                                <th class="bg-light">Metric / Key Indicator</th>
                                <td><t t-esc="doc.metric_id.display_name"/></td>
                            </tr>
                            <tr>
                                <th class="bg-light">Activity Type</th>
                                <td><t t-esc="doc.activity_type"/></td>
                            </tr>
                            <tr>
                                <th class="bg-light">Date</th>
                                <td><t t-esc="doc.date"/></td>
                            </tr>
                            <tr>
                                <th class="bg-light">Academic Year</th>
                                <td><t t-esc="doc.academic_year_id"/></td>
                            </tr>
                            <tr>
                                <th class="bg-light">Faculty Reported By</th>
                                <td><t t-esc="doc.faculty_id.name"/></td>
                            </tr>
                            <tr>
                                <th class="bg-light">Number of Participants</th>
                                <td><t t-esc="doc.participants_count"/></td>
                            </tr>
                            <tr>
                                <th class="bg-light">Status</th>
                                <td><t t-esc="doc.state"/></td>
                            </tr>
                        </table>

                        <t t-if="doc.description">
                            <h5 class="border-bottom pb-2">Activity Description</h5>
                            <p class="mb-4"><t t-esc="doc.description"/></p>
                        </t>

                        <t t-if="doc.outcomes">
                            <h5 class="border-bottom pb-2">Outcomes / Achievements</h5>
                            <p class="mb-4"><t t-esc="doc.outcomes"/></p>
                        </t>

                        <t t-if="doc.evidence_ids">
                            <h5 class="border-bottom pb-2">Supporting Evidence</h5>
                            <table class="table table-bordered mb-4">
                                <thead class="table-light">
                                    <tr>
                                        <th>#</th>
                                        <th>Evidence Title</th>
                                        <th>Document Type</th>
                                        <th>Uploaded By</th>
                                        <th>Verified</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="en" t-value="1"/>
                                    <t t-foreach="doc.evidence_ids" t-as="ev">
                                        <tr>
                                            <td><t t-esc="en"/><t t-set="en" t-value="en + 1"/></td>
                                            <td><t t-esc="ev.name"/></td>
                                            <td><t t-esc="ev.doc_type"/></td>
                                            <td><t t-esc="ev.uploaded_by.name"/></td>
                                            <td><t t-esc="ev.is_verified and 'Yes' or 'No'"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <div class="row mt-5">
                            <div class="col-4 text-center">
                                <div class="border-top pt-2">Faculty</div>
                            </div>
                            <div class="col-4 text-center">
                                <div class="border-top pt-2">HOD</div>
                            </div>
                            <div class="col-4 text-center">
                                <div class="border-top pt-2">IQAC Coordinator</div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
