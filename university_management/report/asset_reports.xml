<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════
         QR LABEL REPORT — printable sticker label per asset
    ══════════════════════════════════════════════════════════ -->
    <template id="asset_qr_label_template" name="Asset QR Label">
        <t t-foreach="docs" t-as="asset">
            <div style="width:8cm; height:4cm; border:1px solid #ccc; border-radius:4px;
                        padding:6px; display:flex; align-items:center; gap:10px;
                        font-family:Arial,sans-serif; page-break-after:always;
                        box-sizing:border-box;">
                <!-- QR Code image -->
                <div style="flex-shrink:0;">
                    <t t-if="asset.qr_code">
                        <img t-attf-src="data:image/png;base64,{{ asset.qr_code }}"
                             style="width:88px; height:88px;" alt="QR Code"/>
                    </t>
                    <t t-else="">
                        <div style="width:88px;height:88px;background:#eee;
                                    display:flex;align-items:center;justify-content:center;
                                    font-size:9px;color:#999;">No QR</div>
                    </t>
                </div>
                <!-- Asset Info -->
                <div style="flex:1; overflow:hidden;">
                    <div style="font-size:10pt; font-weight:bold; color:#111;
                                white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                        <t t-esc="asset.name"/>
                    </div>
                    <div style="font-size:9pt; color:#1d4ed8; font-weight:bold; margin-top:2px;">
                        <t t-esc="asset.asset_code"/>
                    </div>
                    <div style="font-size:8pt; color:#555; margin-top:3px;">
                        <t t-esc="asset.category_id.name or ''"/>
                    </div>
                    <t t-if="asset.serial_number">
                        <div style="font-size:7.5pt; color:#374151; margin-top:2px;">
                            S/N: <t t-esc="asset.serial_number"/>
                        </div>
                    </t>
                    <t t-if="asset.location_id">
                        <div style="font-size:7.5pt; color:#374151; margin-top:2px;">
                            <t t-esc="asset.location_id.complete_name"/>
                        </div>
                    </t>
                    <t t-if="asset.department_id">
                        <div style="font-size:7pt; color:#6B7280; margin-top:2px;">
                            <t t-esc="asset.department_id.name"/>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <record id="action_report_asset_qr_label" model="ir.actions.report">
        <field name="name">Print QR Label</field>
        <field name="model">asset.asset</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">university_management.asset_qr_label_template</field>
        <field name="report_file">university_management.asset_qr_label_template</field>
        <field name="binding_model_id" ref="model_asset_asset"/>
        <field name="binding_type">report</field>
    </record>

    <!-- ══════════════════════════════════════════════════════
         ASSET BY LOCATION REPORT — grouped by inventory location
    ══════════════════════════════════════════════════════════ -->
    <template id="asset_location_report_template" name="Asset Location Report">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 style="color:#1a3a5c; border-bottom:2px solid #2563EB; padding-bottom:8px;">
                        Asset Location Register
                    </h2>
                    <p style="color:#6B7280; font-size:10pt;">
                        Generated on: <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d %b %Y %H:%M')"/>
                    </p>

                    <!-- Collect unique location IDs (recordset, no False values) -->
                    <t t-set="loc_recordset" t-value="docs.filtered(lambda a: a.location_id).mapped('location_id')"/>

                    <!-- Group by location — iterate over unique stock.location records -->
                    <t t-foreach="loc_recordset" t-as="loc">
                        <t t-set="loc_assets" t-value="docs.filtered(lambda a: a.location_id.id == loc.id)"/>
                        <h3 style="color:#0891B2; margin-top:20px; margin-bottom:6px;">
                            <i class="fa fa-map-marker"/> <t t-esc="loc.complete_name"/>
                        </h3>
                        <table style="width:100%; border-collapse:collapse; font-size:9pt; margin-bottom:12px;">
                            <thead>
                                <tr style="background:#1a3a5c; color:#fff;">
                                    <th style="padding:6px 8px; text-align:left;">Asset Code</th>
                                    <th style="padding:6px 8px; text-align:left;">Asset Name</th>
                                    <th style="padding:6px 8px; text-align:left;">Category</th>
                                    <th style="padding:6px 8px; text-align:left;">Serial No.</th>
                                    <th style="padding:6px 8px; text-align:left;">Department</th>
                                    <th style="padding:6px 8px; text-align:left;">Condition</th>
                                    <th style="padding:6px 8px; text-align:left;">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="loc_assets" t-as="asset">
                                    <tr t-attf-style="background:{{ '#f9fafb' if asset_index % 2 == 0 else '#fff' }}; border-bottom:1px solid #e5e7eb;">
                                        <td style="padding:5px 8px; font-weight:bold; color:#2563EB;">
                                            <t t-esc="asset.asset_code"/>
                                        </td>
                                        <td style="padding:5px 8px;"><t t-esc="asset.name"/></td>
                                        <td style="padding:5px 8px;"><t t-esc="asset.category_id.name or '—'"/></td>
                                        <td style="padding:5px 8px;"><t t-esc="asset.serial_number or '—'"/></td>
                                        <td style="padding:5px 8px;"><t t-esc="asset.department_id.name or '—'"/></td>
                                        <td style="padding:5px 8px;"><t t-esc="asset.condition or '—'"/></td>
                                        <td style="padding:5px 8px;"><t t-esc="asset.state"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>

                    <!-- Assets with no inventory location -->
                    <t t-set="no_loc_assets" t-value="docs.filtered(lambda a: not a.location_id)"/>
                    <t t-if="no_loc_assets">
                        <h3 style="color:#d97706; margin-top:20px; margin-bottom:6px;">
                            <i class="fa fa-exclamation-triangle"/> No Inventory Location Assigned
                        </h3>
                        <table style="width:100%; border-collapse:collapse; font-size:9pt;">
                            <thead>
                                <tr style="background:#d97706; color:#fff;">
                                    <th style="padding:6px 8px; text-align:left;">Asset Code</th>
                                    <th style="padding:6px 8px; text-align:left;">Asset Name</th>
                                    <th style="padding:6px 8px; text-align:left;">Category</th>
                                    <th style="padding:6px 8px; text-align:left;">Department</th>
                                    <th style="padding:6px 8px; text-align:left;">Room</th>
                                    <th style="padding:6px 8px; text-align:left;">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="no_loc_assets" t-as="asset">
                                    <tr t-attf-style="background:{{ '#fffbeb' if asset_index % 2 == 0 else '#fff' }}; border-bottom:1px solid #fde68a;">
                                        <td style="padding:5px 8px; font-weight:bold;">
                                            <t t-esc="asset.asset_code"/>
                                        </td>
                                        <td style="padding:5px 8px;"><t t-esc="asset.name"/></td>
                                        <td style="padding:5px 8px;"><t t-esc="asset.category_id.name or '—'"/></td>
                                        <td style="padding:5px 8px;"><t t-esc="asset.department_id.name or '—'"/></td>
                                        <td style="padding:5px 8px;"><t t-esc="asset.room or '—'"/></td>
                                        <td style="padding:5px 8px;"><t t-esc="asset.state"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>

                    <!-- Summary -->
                    <t t-set="with_loc_count" t-value="len(docs.filtered(lambda a: a.location_id))"/>
                    <t t-set="without_loc_count" t-value="len(docs.filtered(lambda a: not a.location_id))"/>
                    <div style="margin-top:24px; padding:12px 16px; background:#f0f4f8;
                                border-radius:8px; border-left:4px solid #2563EB;">
                        <strong>Summary:</strong>
                        Total Assets: <t t-esc="len(docs)"/> |
                        With Location: <t t-esc="with_loc_count"/> |
                        Without Location: <t t-esc="without_loc_count"/>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_asset_by_location" model="ir.actions.report">
        <field name="name">Asset Location Report</field>
        <field name="model">asset.asset</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">university_management.asset_location_report_template</field>
        <field name="report_file">university_management.asset_location_report_template</field>
        <field name="binding_model_id" ref="model_asset_asset"/>
        <field name="binding_type">report</field>
    </record>

</odoo>