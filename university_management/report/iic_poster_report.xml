<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- IIC Poster Print Report Action -->
    <record id="action_report_iic_poster" model="ir.actions.report">
        <field name="name">IIC Event Poster</field>
        <field name="model">iic.poster</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">university_management.report_iic_poster_template</field>
        <field name="report_file">university_management.report_iic_poster_template</field>
        <field name="binding_model_id" ref="model_iic_poster"/>
        <field name="binding_type">report</field>
    </record>

    <!-- QWeb Poster Template -->
    <template id="report_iic_poster_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <!-- base_url for absolute image URLs (needed by wkhtmltopdf on server) -->
                <t t-set="base_url" t-value="request.env['ir.config_parameter'].sudo().get_param('web.base.url')"/>
                <div style="width:210mm; margin:0 auto; padding:0; font-family:Arial,sans-serif; background:#ffffff; box-sizing:border-box;">

                    <!-- HEADER BAND -->
                    <div style="background:#1a237e; padding:18px 24px 14px 24px; border-bottom:5px solid #ffd600;">
                        <table style="width:100%; border-collapse:collapse;">
                            <tr>
                                <td style="width:80px; text-align:center; vertical-align:middle;">
                                    <t t-if="doc.institute_logo">
                                        <img t-att-src="base_url + '/web/image/iic.poster/' + str(doc.id) + '/institute_logo'"
                                             style="max-width:70px; max-height:70px;" alt="Institute Logo"/>
                                    </t>
                                    <t t-else="">
                                        <div style="width:70px;height:70px;background:#ffffff22;border-radius:50%;color:#fff;font-size:9px;text-align:center;line-height:70px;">LOGO</div>
                                    </t>
                                </td>
                                <td style="text-align:center; vertical-align:middle; color:#ffffff; padding:0 12px;">
                                    <div style="font-size:11px; letter-spacing:3px; text-transform:uppercase; color:#ffd600; font-weight:600; margin-bottom:4px;">
                                        Institute Innovation Council (IIC)
                                    </div>
                                    <div style="font-size:20px; font-weight:800; line-height:1.2; text-transform:uppercase; letter-spacing:1px;">
                                        <t t-esc="doc.event_title or doc.name"/>
                                    </div>
                                    <t t-if="doc.tagline">
                                        <div style="font-size:11px; color:#b3c5f7; margin-top:5px; font-style:italic;">
                                            <t t-esc="doc.tagline"/>
                                        </div>
                                    </t>
                                </td>
                                <td style="width:80px; text-align:center; vertical-align:middle;">
                                    <t t-if="doc.iic_logo">
                                        <img t-att-src="base_url + '/web/image/iic.poster/' + str(doc.id) + '/iic_logo'"
                                             style="max-width:70px; max-height:70px;" alt="IIC Logo"/>
                                    </t>
                                    <t t-else="">
                                        <div style="width:70px;height:70px;background:#ffffff22;border-radius:50%;color:#fff;font-size:9px;text-align:center;line-height:70px;">IIC</div>
                                    </t>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- HIGHLIGHT STRIP -->
                    <t t-if="doc.highlight_text">
                        <div style="background:#ffd600; color:#1a237e; text-align:center; font-size:13px; font-weight:700; padding:7px 20px; letter-spacing:1px; text-transform:uppercase;">
                            * <t t-esc="doc.highlight_text"/> *
                        </div>
                    </t>

                    <!-- EVENT INFO ROW -->
                    <div style="background:#e8eaf6; padding:10px 24px; border-bottom:2px solid #c5cae9;">
                        <table style="width:100%; border-collapse:collapse;">
                            <tr>
                                <td style="width:33%; text-align:center; border-right:1px solid #9fa8da; padding:6px 10px;">
                                    <div style="font-size:9px; color:#7986cb; text-transform:uppercase; letter-spacing:1px; font-weight:600;">Date &amp; Time</div>
                                    <div style="font-size:13px; font-weight:700; color:#1a237e; margin-top:3px;">
                                        <t t-if="doc.event_date">
                                            <t t-esc="doc.event_date" t-options='{"widget": "datetime", "format": "dd MMM yyyy, hh:mm a"}'/>
                                        </t>
                                        <t t-else="">TBA</t>
                                    </div>
                                </td>
                                <td style="width:33%; text-align:center; border-right:1px solid #9fa8da; padding:6px 10px;">
                                    <div style="font-size:9px; color:#7986cb; text-transform:uppercase; letter-spacing:1px; font-weight:600;">Venue</div>
                                    <div style="font-size:13px; font-weight:700; color:#1a237e; margin-top:3px;">
                                        <t t-esc="doc.venue or 'To be announced'"/>
                                    </div>
                                </td>
                                <td style="width:34%; text-align:center; padding:6px 10px;">
                                    <div style="font-size:9px; color:#7986cb; text-transform:uppercase; letter-spacing:1px; font-weight:600;">Event Type</div>
                                    <div style="font-size:13px; font-weight:700; color:#1a237e; margin-top:3px;">
                                        <t t-esc="dict(doc.fields_get(['template_type'])['template_type']['selection']).get(doc.template_type, doc.template_type)"/>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- MAIN CONTENT -->
                    <div style="padding:20px 24px;">
                        <table style="width:100%; border-collapse:collapse;">
                            <tr>
                                <!-- Speaker Card -->
                                <td style="width:42%; vertical-align:top; padding-right:14px;">
                                    <div style="background:#1a237e; border-radius:10px; padding:20px 16px; text-align:center; color:#fff;">
                                        <div style="font-size:10px; letter-spacing:2px; text-transform:uppercase; color:#ffd600; margin-bottom:12px; font-weight:600;">
                                            Resource Person
                                        </div>
                                        <t t-if="doc.speaker_photo">
                                            <div style="margin:0 auto 12px auto; width:90px; height:90px; border-radius:50%; overflow:hidden; border:3px solid #ffd600; background:#fff;">
                                                <img t-att-src="base_url + '/web/image/iic.poster/' + str(doc.id) + '/speaker_photo'"
                                                     style="width:90px; height:90px; object-fit:cover;" alt="Speaker"/>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <div style="width:90px;height:90px;border-radius:50%;background:#3949ab;border:3px solid #ffd600;margin:0 auto 12px auto;text-align:center;line-height:90px;font-size:28px;color:#ffd600;">?</div>
                                        </t>
                                        <div style="font-size:16px; font-weight:800; color:#ffffff; line-height:1.2;">
                                            <t t-esc="doc.speaker_name or 'TBA'"/>
                                        </div>
                                        <t t-if="doc.speaker_designation">
                                            <div style="font-size:11px; color:#90caf9; margin-top:5px; font-style:italic;">
                                                <t t-esc="doc.speaker_designation"/>
                                            </div>
                                        </t>
                                        <t t-if="doc.speaker_profile">
                                            <div style="font-size:10px; color:#c5cae9; margin-top:10px; line-height:1.5; text-align:left; background:#ffffff22; border-radius:6px; padding:8px;">
                                                <t t-esc="doc.speaker_profile"/>
                                            </div>
                                        </t>
                                    </div>
                                </td>

                                <!-- Right Side -->
                                <td style="vertical-align:top;">
                                    <!-- About Event -->
                                    <div style="background:#f5f5f5; border-left:4px solid #1a237e; border-radius:0 8px 8px 0; padding:12px 14px; margin-bottom:14px;">
                                        <div style="font-size:11px; font-weight:700; color:#1a237e; text-transform:uppercase; letter-spacing:1px; margin-bottom:6px;">About the Event</div>
                                        <t t-if="doc.event_id and doc.event_id.description">
                                            <div style="font-size:11px; color:#37474f; line-height:1.6;">
                                                <t t-raw="doc.event_id.description"/>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <div style="font-size:11px; color:#78909c; font-style:italic;">
                                                Join us for an insightful session on innovation and entrepreneurship, organised by the Institute Innovation Council.
                                            </div>
                                        </t>
                                    </div>

                                    <!-- IIC Leadership -->
                                    <div style="background:#fff8e1; border:1.5px solid #ffd600; border-radius:8px; padding:12px 14px;">
                                        <div style="font-size:11px; font-weight:700; color:#f57f17; text-transform:uppercase; letter-spacing:1px; margin-bottom:10px; border-bottom:1px dashed #ffd600; padding-bottom:5px;">
                                            IIC Leadership
                                        </div>
                                        <table style="width:100%; border-collapse:separate; border-spacing:6px;">
                                            <tr>
                                                <td style="text-align:center; background:#fff; border-radius:6px; padding:8px 6px; border:1px solid #ffe082;">
                                                    <div style="font-size:9px; color:#f57f17; font-weight:600; text-transform:uppercase;">IIC President</div>
                                                    <div style="font-size:12px; font-weight:700; color:#1a237e; margin-top:4px;">
                                                        <t t-esc="doc.iic_president_name or '—'"/>
                                                    </div>
                                                    <t t-if="doc.iic_president_designation">
                                                        <div style="font-size:10px; color:#78909c; font-style:italic;">
                                                            <t t-esc="doc.iic_president_designation"/>
                                                        </div>
                                                    </t>
                                                </td>
                                                <td style="text-align:center; background:#fff; border-radius:6px; padding:8px 6px; border:1px solid #ffe082;">
                                                    <div style="font-size:9px; color:#f57f17; font-weight:600; text-transform:uppercase;">IIC Convenor</div>
                                                    <div style="font-size:12px; font-weight:700; color:#1a237e; margin-top:4px;">
                                                        <t t-esc="doc.iic_convenor_name or '—'"/>
                                                    </div>
                                                    <t t-if="doc.iic_convenor_designation">
                                                        <div style="font-size:10px; color:#78909c; font-style:italic;">
                                                            <t t-esc="doc.iic_convenor_designation"/>
                                                        </div>
                                                    </t>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- CALL TO ACTION -->
                    <div style="margin:0 24px 14px 24px; background:#e8f5e9; border:1.5px solid #a5d6a7; border-radius:8px; padding:10px 16px; text-align:center;">
                        <span style="font-size:12px; color:#2e7d32; font-weight:700;">
                            All Students, Faculty and Staff are cordially invited to attend!
                        </span>
                    </div>

                    <!-- FOOTER BAND -->
                    <div style="background:#1a237e; color:#fff; padding:10px 24px; border-top:4px solid #ffd600; margin-top:20px;">
                        <table style="width:100%; border-collapse:collapse;">
                            <tr>
                                <td style="font-size:10px; color:#90caf9;">Ministry of Education, Govt. of India | MSME</td>
                                <td style="font-size:10px; color:#ffd600; font-weight:600; text-transform:uppercase; letter-spacing:1px; text-align:center;">Institute Innovation Council</td>
                                <td style="font-size:10px; color:#90caf9; text-align:right;">
                                    <t t-if="doc.publish_date">
                                        Published: <t t-esc="doc.publish_date" t-options='{"widget": "date", "format": "dd MMM yyyy"}'/>
                                    </t>
                                    <t t-else="">
                                        Poster #<t t-esc="doc.id"/>
                                    </t>
                                </td>
                            </tr>
                        </table>
                    </div>

                </div>
            </t>
        </t>
    </template>

</odoo>