<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bulk_omr_scan_wizard_form" model="ir.ui.view">
        <field name="name">exam.omr.bulk.scan.wizard.form</field>
        <field name="model">exam.omr.bulk.scan.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk OMR Scan">
                <group>
                    <group string="Defaults">
                        <field name="examination_id"/>
                        <field name="subject_id"/>
                        <field name="valuation_part"/>
                        <field name="auto_confirm"/>
                    </group>
                </group>
                <group string="Upload Scanned Sheets">
                    <field name="bulk_upload_helper" widget="bulk_omr_multi_upload" nolabel="1"/>
                    <field name="scan_line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="scanned_file" filename="scanned_filename"/>
                            <field name="scanned_filename" invisible="1"/>
                        </list>
                    </field>
                </group>
                <footer>
                    <button name="action_process" type="object"
                            string="Process All Scans" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bulk_omr_scan_wizard" model="ir.actions.act_window">
        <field name="name">Bulk OMR Scan</field>
        <field name="res_model">exam.omr.bulk.scan.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>