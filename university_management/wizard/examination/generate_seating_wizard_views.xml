<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="generate_examination_seating_wizard_view_form" model="ir.ui.view">
        <field name="name">generate.examination.seating.wizard.view.form</field>
        <field name="model">generate.examination.seating.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Seating Arrangement">
                <sheet>
                    <div class="oe_title">
                        <h1>Generate Seating Arrangement</h1>
                    </div>
                    <group>
                        <group>
                            <field name="examination_id"/>
                            <field name="students_per_room"/>
                        </group>
                        <group>
                            <field name="clear_existing"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate"
                            string="Generate Seating"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_examination_generate_seating_wizard" model="ir.actions.act_window">
        <field name="name">Generate Seating Arrangement</field>
        <field name="res_model">generate.examination.seating.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>