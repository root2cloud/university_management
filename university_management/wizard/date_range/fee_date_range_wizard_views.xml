<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard Form View -->
    <record id="fee_date_range_wizard_view_form" model="ir.ui.view">
        <field name="name">fee.date.range.wizard.view.form</field>
        <field name="model">fee.date.range.wizard</field>
        <field name="arch" type="xml">
            <form string="Filter Fee Payments by Date Range">
                <sheet>
                    <!-- Date Pickers -->
                    <group string="Select Date Range">
                        <group>
                            <field name="date_from" widget="date"/>
                        </group>
                        <group>
                            <field name="date_to" widget="date"/>
                        </group>
                    </group>

                    <!-- Live Summary Preview -->
                    <group string="Preview for Selected Range">
                        <group>
                            <field name="total_transactions" readonly="1"/>
                            <field name="total_collected"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1"/>
                        </group>
                        <group>
                            <field name="total_pending"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>

                <footer>
                    <button name="action_view_transactions"
                            string="View Transactions"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_fee_date_range_wizard" model="ir.actions.act_window">
        <field name="name">Filter by Date Range</field>
        <field name="res_model">fee.date.range.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>