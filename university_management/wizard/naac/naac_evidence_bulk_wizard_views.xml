<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="naac_evidence_bulk_wizard_view_form" model="ir.ui.view">
        <field name="name">naac.evidence.bulk.wizard.view.form</field>
        <field name="model">naac.evidence.bulk.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Evidence Upload">
                <group>
                    <group string="Tag Evidence To">
                        <field name="criterion_id" options="{'no_create': True}"/>
                        <field name="metric_id" options="{'no_create': True}"/>
                        <field name="department_id"/>
                        <field name="academic_year_id"/>
                    </group>
                </group>
                <group string="Files to Upload">
                    <field name="evidence_line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="doc_type"/>
                            <field name="document" widget="binary" filename="document_filename"/>
                            <field name="document_filename"/>
                        </list>
                    </field>
                </group>
                <footer>
                    <button name="action_save_evidence" string="Upload Evidence" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-default"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_naac_evidence_bulk_wizard" model="ir.actions.act_window">
        <field name="name">Bulk Upload Evidence</field>
        <field name="res_model">naac.evidence.bulk.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
