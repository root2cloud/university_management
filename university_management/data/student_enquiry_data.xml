<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ── UTM Sources for admission lead tracking ─────────────── -->
        <record id="utm_source_education_fair" model="utm.source">
            <field name="name">Education Fair</field>
        </record>
        <record id="utm_source_walk_in" model="utm.source">
            <field name="name">Walk-in</field>
        </record>
        <record id="utm_source_referral" model="utm.source">
            <field name="name">Referral</field>
        </record>
        <record id="utm_source_school_visit" model="utm.source">
            <field name="name">School Visit</field>
        </record>
        <record id="utm_source_phone_enquiry" model="utm.source">
            <field name="name">Phone Enquiry</field>
        </record>
        <record id="utm_source_whatsapp" model="utm.source">
            <field name="name">WhatsApp</field>
        </record>

    </data>

    <data noupdate="0">

        <!-- ── Cron: Daily follow-up reminders ────────────────────── -->
        <record id="cron_student_enquiry_followup" model="ir.cron">
            <field name="name">Student Enquiry: Follow-up Reminders</field>
            <field name="model_id" ref="model_student_enquiry"/>
            <field name="state">code</field>
            <field name="code">model._cron_remind_follow_ups()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>