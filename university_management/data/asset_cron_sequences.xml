<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  ASSET ALERT CRON JOBS — all 4 types as per client spec        -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <!-- 1. Low Stock Alert (consumable assets below min_stock_qty) -->
    <record id="ir_cron_asset_low_stock_alert" model="ir.cron">
        <field name="name">Asset: Daily Low Stock Alert</field>
        <field name="model_id" ref="model_asset_asset"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_low_stock()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="priority">10</field>
    </record>

    <!-- 2. License Expiry Alert (digital assets expiring within 30 days) -->
    <record id="ir_cron_asset_license_expiry" model="ir.cron">
        <field name="name">Asset: Daily License Expiry Alert (30-day warning)</field>
        <field name="model_id" ref="model_asset_asset"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_license_expiry()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="priority">10</field>
    </record>

    <!-- 3. Maintenance Due Alert -->
    <record id="ir_cron_asset_maintenance_due_alert" model="ir.cron">
        <field name="name">Asset: Daily Maintenance Due Alert</field>
        <field name="model_id" ref="model_asset_asset"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_maintenance_due_alert()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="priority">10</field>
    </record>

    <!-- 4. Unscanned Asset Alert (no QR scan in 30+ days) -->
    <record id="ir_cron_asset_unscanned_alert" model="ir.cron">
        <field name="name">Asset: Daily Unscanned Asset Alert (30-day threshold)</field>
        <field name="model_id" ref="model_asset_asset"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_unscanned_assets()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="priority">10</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  SEQUENCES                                                      -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <record id="seq_asset_purchase_request" model="ir.sequence">
        <field name="name">Asset Purchase Request</field>
        <field name="code">asset.purchase.request</field>
        <field name="prefix">APREQ/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <record id="seq_asset_handover" model="ir.sequence">
        <field name="name">Asset Handover Request</field>
        <field name="code">asset.handover</field>
        <field name="prefix">AHOV/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <record id="seq_asset_audit_v2" model="ir.sequence">
        <field name="name">Asset Audit</field>
        <field name="code">asset.audit</field>
        <field name="prefix">AAUD/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <record id="seq_asset_stock_issue" model="ir.sequence">
        <field name="name">Asset Stock Issue</field>
        <field name="code">asset.stock.issue</field>
        <field name="prefix">AISS/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

</odoo>