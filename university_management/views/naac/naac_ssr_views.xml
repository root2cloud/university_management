<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="naac_ssr_view_form" model="ir.ui.view">
        <field name="name">naac.ssr.view.form</field>
        <field name="model">naac.ssr</field>
        <field name="arch" type="xml">
            <form string="SSR - Self Study Report">
                <header>
                    <button name="action_generate_from_aqar" string="Pull from AQARs" type="object"
                            class="btn-secondary"/>
                    <button name="action_submit_iqac" string="Submit to IQAC" type="object"
                            class="btn-primary" invisible="state not in ['draft', 'data_collection']"/>
                    <button name="action_finalize" string="Finalize SSR" type="object"
                            class="btn-success" invisible="state not in ['iqac_review', 'management_review']"/>
                    <button name="action_submit_naac" string="Submit to NAAC" type="object"
                            invisible="state != 'finalized'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,data_collection,iqac_review,finalized,submitted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-file" type="object"
                                name="action_generate_from_aqar">
                            <field name="total_evidence_docs" widget="statinfo" string="Evidence Docs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="accreditation_cycle"/>
                            <field name="from_year"/>
                            <field name="to_year"/>
                        </group>
                        <group>
                            <field name="prepared_by"/>
                            <field name="approved_by"/>
                            <field name="finalized_date"/>
                        </group>
                    </group>
                    <group string="Referenced AQARs">
                        <field name="aqar_ids" widget="many2many_tags" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Executive Summary" name="exec_summary">
                            <field name="executive_summary" nolabel="1"/>
                        </page>
                        <page string="Institutional Profile" name="profile">
                            <field name="institutional_profile" nolabel="1"/>
                        </page>
                        <page string="Criterion 1" name="c1"><field name="criterion1_ssr" nolabel="1"/></page>
                        <page string="Criterion 2" name="c2"><field name="criterion2_ssr" nolabel="1"/></page>
                        <page string="Criterion 3" name="c3"><field name="criterion3_ssr" nolabel="1"/></page>
                        <page string="Criterion 4" name="c4"><field name="criterion4_ssr" nolabel="1"/></page>
                        <page string="Criterion 5" name="c5"><field name="criterion5_ssr" nolabel="1"/></page>
                        <page string="Criterion 6" name="c6"><field name="criterion6_ssr" nolabel="1"/></page>
                        <page string="Criterion 7" name="c7"><field name="criterion7_ssr" nolabel="1"/></page>
                        <page string="Evidence Summary" name="evidence">
                            <field name="evidence_summary" nolabel="1" placeholder="Evidence summary..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="naac_ssr_view_list" model="ir.ui.view">
        <field name="name">naac.ssr.view.list</field>
        <field name="model">naac.ssr</field>
        <field name="arch" type="xml">
            <list string="SSR Reports">
                <field name="name"/>
                <field name="accreditation_cycle"/>
                <field name="from_year"/>
                <field name="to_year"/>
                <field name="total_evidence_docs"/>
                <field name="prepared_by"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'submitted'"
                       decoration-warning="state == 'iqac_review'"/>
            </list>
        </field>
    </record>

    <record id="naac_ssr_view_search" model="ir.ui.view">
        <field name="name">naac.ssr.view.search</field>
        <field name="model">naac.ssr</field>
        <field name="arch" type="xml">
            <search string="Search SSR">
                <field name="name"/>
                <field name="accreditation_cycle"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Finalized" name="finalized" domain="[('state', '=', 'finalized')]"/>
            </search>
        </field>
    </record>

    <record id="action_naac_ssr" model="ir.actions.act_window">
        <field name="name">SSR Reports</field>
        <field name="res_model">naac.ssr</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="naac_ssr_view_search"/>
    </record>

</odoo>
