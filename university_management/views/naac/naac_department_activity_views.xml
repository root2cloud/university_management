<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="naac_dept_activity_view_form" model="ir.ui.view">
        <field name="name">naac.department.activity.view.form</field>
        <field name="model">naac.department.activity</field>
        <field name="arch" type="xml">
            <form string="NAAC Department Activity">
                <header>
                    <button name="action_submit" string="Submit" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_verify" string="Verify" type="object"
                            class="btn-success" invisible="state != 'submitted'"
                            groups="university_management.group_university_admin"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state != 'submitted'"/>
                    <button name="action_reset_draft" string="Reset Draft" type="object"
                            invisible="state not in ['submitted', 'rejected']"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,verified"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-file" type="object"
                                name="action_submit">
                            <field name="evidence_count" widget="statinfo" string="Evidence"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Activity Title"/></h1>
                        <field name="reference" class="text-muted"/>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="department_id" options="{'no_create': True}"/>
                            <field name="faculty_id" options="{'no_create': True}"/>
                            <field name="criterion_id" options="{'no_create': True}"/>
                            <field name="metric_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Details">
                            <field name="activity_type"/>
                            <field name="date"/>
                            <field name="academic_year_id"/>
                            <field name="participants_count"/>
                        </group>
                    </group>
                    <group string="Description &amp; Outcomes">
                        <field name="description" nolabel="1" placeholder="Activity description..."/>
                        <field name="outcomes" nolabel="1" placeholder="Outcomes and achievements..."/>
                    </group>
                    <notebook>
                        <page string="Evidence" name="evidence">
                            <field name="evidence_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="doc_type"/>
                                    <field name="document" widget="binary"/>
                                    <field name="document_filename"/>
                                    <field name="upload_date"/>
                                    <field name="is_verified"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="naac_dept_activity_view_list" model="ir.ui.view">
        <field name="name">naac.department.activity.view.list</field>
        <field name="model">naac.department.activity</field>
        <field name="arch" type="xml">
            <list string="NAAC Activities" decoration-success="state == 'verified'"
                  decoration-warning="state == 'submitted'">
                <field name="reference"/>
                <field name="name"/>
                <field name="department_id"/>
                <field name="criterion_id"/>
                <field name="activity_type"/>
                <field name="date"/>
                <field name="academic_year_id"/>
                <field name="faculty_id"/>
                <field name="participants_count"/>
                <field name="evidence_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'verified'"
                       decoration-warning="state == 'submitted'"/>
            </list>
        </field>
    </record>

    <record id="naac_dept_activity_view_kanban" model="ir.ui.view">
        <field name="name">naac.department.activity.view.kanban</field>
        <field name="model">naac.department.activity</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="department_id"/>
                <field name="criterion_id"/>
                <field name="state"/>
                <field name="date"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <strong><field name="name"/></strong>
                                <div class="text-muted"><field name="department_id"/></div>
                                <div><field name="criterion_id"/></div>
                                <div><i class="fa fa-calendar"/> <field name="date"/></div>
                                <field name="state" widget="badge"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="naac_dept_activity_view_search" model="ir.ui.view">
        <field name="name">naac.department.activity.view.search</field>
        <field name="model">naac.department.activity</field>
        <field name="arch" type="xml">
            <search string="Search Activities">
                <field name="name"/>
                <field name="department_id"/>
                <field name="criterion_id"/>
                <field name="faculty_id"/>
                <field name="academic_year_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Verified" name="verified" domain="[('state', '=', 'verified')]"/>
                <group expand="0" string="Group By">
                    <filter string="Department" name="group_dept" context="{'group_by': 'department_id'}"/>
                    <filter string="Criterion" name="group_criterion" context="{'group_by': 'criterion_id'}"/>
                    <filter string="Activity Type" name="group_type" context="{'group_by': 'activity_type'}"/>
                    <filter string="Academic Year" name="group_year" context="{'group_by': 'academic_year_id'}"/>
                    <filter string="Month" name="group_month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="naac_dept_activity_view_graph" model="ir.ui.view">
        <field name="name">naac.department.activity.view.graph</field>
        <field name="model">naac.department.activity</field>
        <field name="arch" type="xml">
            <graph string="Activities by Department" type="bar">
                <field name="department_id" type="row"/>
                <field name="criterion_id" type="col"/>
            </graph>
        </field>
    </record>

    <record id="naac_dept_activity_view_pivot" model="ir.ui.view">
        <field name="name">naac.department.activity.view.pivot</field>
        <field name="model">naac.department.activity</field>
        <field name="arch" type="xml">
            <pivot string="Activity Pivot">
                <field name="department_id" type="row"/>
                <field name="criterion_id" type="col"/>
                <field name="participants_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_naac_department_activity" model="ir.actions.act_window">
        <field name="name">Department Activities</field>
        <field name="res_model">naac.department.activity</field>
        <field name="view_mode">list,kanban,graph,pivot,form</field>
        <field name="search_view_id" ref="naac_dept_activity_view_search"/>
    </record>

</odoo>
