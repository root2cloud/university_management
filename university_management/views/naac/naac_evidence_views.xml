<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="naac_evidence_view_form" model="ir.ui.view">
        <field name="name">naac.evidence.view.form</field>
        <field name="model">naac.evidence</field>
        <field name="arch" type="xml">
            <form string="NAAC Evidence">
                <header>
                    <button name="action_verify" string="Mark Verified" type="object"
                            class="btn-success" invisible="is_verified"
                            groups="university_management.group_university_admin"/>
                </header>
                <sheet>
                    <group>
                        <group string="Classification">
                            <field name="name"/>
                            <field name="criterion_id" options="{'no_create': True}"/>
                            <field name="metric_id" options="{'no_create': True}"/>
                            <field name="department_id"/>
                            <field name="academic_year_id"/>
                            <field name="doc_type"/>
                        </group>
                        <group string="File">
                            <field name="document" widget="binary" filename="document_filename"/>
                            <field name="document_filename"/>
                            <field name="file_size"/>
                            <field name="upload_date"/>
                            <field name="uploaded_by"/>
                        </group>
                    </group>
                    <group string="Verification">
                        <field name="is_verified"/>
                        <field name="verified_by" invisible="not is_verified"/>
                        <field name="verified_date" invisible="not is_verified"/>
                    </group>
                    <group string="Activity Link">
                        <field name="activity_id" options="{'no_create': True}"/>
                    </group>
                    <group string="Notes &amp; Tags">
                        <field name="description" nolabel="1"/>
                        <field name="tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="naac_evidence_view_list" model="ir.ui.view">
        <field name="name">naac.evidence.view.list</field>
        <field name="model">naac.evidence</field>
        <field name="arch" type="xml">
            <list string="NAAC Evidence" decoration-success="is_verified">
                <field name="reference"/>
                <field name="name"/>
                <field name="criterion_id"/>
                <field name="metric_id"/>
                <field name="department_id"/>
                <field name="doc_type"/>
                <field name="academic_year_id"/>
                <field name="file_size"/>
                <field name="upload_date"/>
                <field name="is_verified" widget="boolean_favorite"/>
            </list>
        </field>
    </record>

    <record id="naac_evidence_view_kanban" model="ir.ui.view">
        <field name="name">naac.evidence.view.kanban</field>
        <field name="model">naac.evidence</field>
        <field name="arch" type="xml">
            <kanban default_group_by="criterion_id">
                <field name="name"/>
                <field name="criterion_id"/>
                <field name="doc_type"/>
                <field name="is_verified"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <i class="fa fa-file-pdf-o fa-2x text-danger"/>
                                <strong class="ms-2"><field name="name"/></strong>
                                <div class="text-muted mt-1"><field name="doc_type"/></div>
                                <div><field name="department_id"/></div>
                                <div class="mt-2">
                                    <span t-if="record.is_verified.raw_value" class="badge badge-success">
                                        Verified
                                    </span>
                                    <span t-else="" class="badge badge-secondary">
                                        Pending
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="naac_evidence_view_search" model="ir.ui.view">
        <field name="name">naac.evidence.view.search</field>
        <field name="model">naac.evidence</field>
        <field name="arch" type="xml">
            <search string="Search Evidence">
                <field name="name"/>
                <field name="criterion_id"/>
                <field name="department_id"/>
                <field name="academic_year_id"/>
                <field name="tags"/>
                <separator/>
                <filter string="Verified" name="verified" domain="[('is_verified', '=', True)]"/>
                <filter string="Pending Verification" name="pending" domain="[('is_verified', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Criterion" name="group_criterion" context="{'group_by': 'criterion_id'}"/>
                    <filter string="Department" name="group_dept" context="{'group_by': 'department_id'}"/>
                    <filter string="Document Type" name="group_type" context="{'group_by': 'doc_type'}"/>
                    <filter string="Academic Year" name="group_year" context="{'group_by': 'academic_year_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_naac_evidence" model="ir.actions.act_window">
        <field name="name">Evidence Repository</field>
        <field name="res_model">naac.evidence</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="naac_evidence_view_search"/>
    </record>

</odoo>
