<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Adds a "Student Ledger" notebook page to the student.student form view.
        Shows all account.move.line entries linked to the student's partner
        (receivable account) — Date, Journal Entry, Due Date, Balance Amount.
        Mirrors the "Payment Follow-up" tab logic from om_account_followup.
    -->
    <record id="student_ledger_view_form_inherit" model="ir.ui.view">
        <field name="name">student.student.view.form.ledger.inherit</field>
        <field name="model">student.student</field>
        <field name="inherit_id" ref="university_management.student_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook/page[@name='discipline']" position="after">
                <page string="Student Ledger" name="student_ledger"
                      groups="account.group_account_invoice">

                    <group>
                        <group>
                            <field name="student_ledger_balance"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <field name="student_ledger_line_ids"
                           readonly="1"
                           nolabel="1">
                        <list string="Student Ledger"
                              create="false"
                              delete="false">
                            <field name="date"
                                   string="Date"
                                   readonly="1"/>
                            <field name="move_id"
                                   string="Journal Entry"
                                   readonly="1"/>
                            <field name="date_maturity"
                                   string="Due Date"
                                   readonly="1"/>
                            <field name="amount_residual"
                                   string="Balance Amount"
                                   readonly="1"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   sum="Total Balance"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>

                </page>
            </xpath>

        </field>
    </record>

</odoo>