<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================== -->
    <!-- FORM VIEW                                                           -->
    <!-- ================================================================== -->
    <record id="student_assignment_view_form" model="ir.ui.view">
        <field name="name">student.assignment.view.form</field>
        <field name="model">student.assignment</field>
        <field name="arch" type="xml">
            <form string="Assignment">
                <header>
                    <button name="action_publish" type="object"
                            string="Publish" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_close" type="object"
                            string="Close Submissions" class="oe_highlight"
                            invisible="state != 'published'"/>
                    <button name="action_mark_graded" type="object"
                            string="Mark All Graded" class="oe_highlight"
                            invisible="state != 'closed'"/>
                    <button name="action_cancel" type="object"
                            string="Cancel" class="btn-default"
                            invisible="state in ['graded', 'cancelled']"
                            confirm="Are you sure you want to cancel this assignment?"/>
                    <button name="action_reset_draft" type="object"
                            string="Reset to Draft" class="btn-default"
                            invisible="state not in ['cancelled', 'published']"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,published,closed,graded"/>
                </header>
                <sheet>
                    <!-- FIXED: stat buttons use widget="statinfo" on a field,
                         not manual o_stat_info HTML divs -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_submissions" type="object"
                                class="oe_stat_button" icon="fa-upload">
                            <field name="submission_count"
                                   widget="statinfo" string="Submitted"/>
                        </button>
                        <button name="action_view_submissions" type="object"
                                class="oe_stat_button" icon="fa-check-circle">
                            <field name="graded_count"
                                   widget="statinfo" string="Graded"/>
                        </button>
                        <button name="action_view_submissions" type="object"
                                class="oe_stat_button" icon="fa-hourglass-half">
                            <field name="pending_count"
                                   widget="statinfo" string="Pending"/>
                        </button>
                        <button name="action_view_submissions" type="object"
                                class="oe_stat_button" icon="fa-bar-chart">
                            <field name="average_marks"
                                   widget="statinfo" string="Avg. Marks"/>
                        </button>
                    </div>

                    <!-- Ribbon for overdue -->
                    <widget name="web_ribbon" title="Overdue"
                            bg_color="text-bg-danger"
                            invisible="not is_overdue"/>
                    <widget name="web_ribbon" title="Graded"
                            bg_color="text-bg-success"
                            invisible="state != 'graded'"/>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Assignment Title..."/>
                        </h1>
                        <h4>
                            <field name="code" readonly="1"
                                   placeholder="Auto-generated code"/>
                        </h4>
                    </div>

                    <group>
                        <group string="Basic Information">
                            <field name="assignment_type"/>
                            <field name="subject_id"/>
                            <field name="faculty_id"/>
                        </group>
                        <group string="Academic Context">
                            <field name="academic_year_id"/>
                            <field name="semester_id"/>
                            <field name="department_id"/>
                            <field name="program_id"/>
                            <field name="batch_id"/>
                        </group>
                    </group>

                    <group>
                        <group string="Dates">
                            <field name="assigned_date"/>
                            <field name="deadline"/>
                            <field name="extended_deadline"/>
                        </group>
                        <group string="Marks">
                            <field name="max_marks"/>
                            <field name="passing_marks"/>
                            <field name="weightage"/>
                            <field name="average_marks" readonly="1"/>
                            <field name="submission_rate" readonly="1"
                                   widget="progressbar"/>
                        </group>
                    </group>

                    <group>
                        <group string="Submission Settings">
                            <field name="submission_type"/>
                            <field name="allow_late_submission"/>
                            <field name="late_submission_penalty"
                                   invisible="not allow_late_submission"/>
                        </group>
                        <group string="Advanced">
                            <field name="use_rubric_grading"/>
                            <field name="enable_plagiarism_flag"/>
                            <field name="send_reminder"/>
                            <field name="reminder_days_before"
                                   invisible="not send_reminder"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description / Instructions">
                            <field name="description"
                                   placeholder="Enter the assignment instructions..."/>
                        </page>
                        <page string="Grading Criteria"
                              invisible="not use_rubric_grading">
                            <button name="action_bulk_create_submissions"
                                    type="object" string="📋 Create Submissions for Batch"
                                    class="btn-secondary mb-2"
                                    invisible="state == 'draft' or not batch_id"/>
                            <field name="criteria_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="description"/>
                                    <field name="max_marks"/>
                                    <field name="weightage"/>
                                </list>
                            </field>
                        </page>
                        <page string="Actions" invisible="state == 'draft'">
                            <button name="action_bulk_create_submissions"
                                    type="object"
                                    string="📋 Create Submission Records for Entire Batch"
                                    class="btn-primary"
                                    invisible="not batch_id"/>
                            <p class="text-muted mt-2">
                                Automatically creates a 'Not Submitted' record for every
                                enrolled student in the batch, so you can track who has
                                not submitted.
                            </p>
                        </page>
                        <page string="Reference Attachments">
                            <field name="attachment_ids"
                                   widget="many2many_binary"/>
                        </page>
                        <page string="Internal Notes">
                            <field name="notes"
                                   placeholder="Internal notes (not visible to students)..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- LIST VIEW                                                           -->
    <!-- ================================================================== -->
    <record id="student_assignment_view_list" model="ir.ui.view">
        <field name="name">student.assignment.view.list</field>
        <field name="model">student.assignment</field>
        <field name="arch" type="xml">
            <!-- FIXED: removed invalid current_date domain decoration -->
            <list string="Assignments"
                  decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'graded'"
                  decoration-warning="state == 'closed'">
                <field name="code"/>
                <field name="name"/>
                <field name="assignment_type" widget="badge"
                       decoration-info="assignment_type == 'homework'"
                       decoration-primary="assignment_type == 'assignment'"
                       decoration-warning="assignment_type == 'quiz'"/>
                <field name="subject_id"/>
                <field name="faculty_id"/>
                <field name="batch_id"/>
                <field name="assigned_date"/>
                <field name="deadline"/>
                <field name="max_marks"/>
                <field name="submission_count"/>
                <field name="graded_count"/>
                <field name="average_marks"/>
                <field name="submission_rate" widget="progressbar"
                       optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-primary="state == 'published'"
                       decoration-warning="state == 'closed'"
                       decoration-success="state == 'graded'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- KANBAN VIEW                                                         -->
    <!-- ================================================================== -->
    <record id="student_assignment_view_kanban" model="ir.ui.view">
        <field name="name">student.assignment.view.kanban</field>
        <field name="model">student.assignment</field>
        <field name="arch" type="xml">
            <!-- FIXED: removed o_kanban_record_has_image_fill (no image field) -->
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="code"/>
                <field name="assignment_type"/>
                <field name="subject_id"/>
                <field name="faculty_id"/>
                <field name="deadline"/>
                <field name="max_marks"/>
                <field name="submission_count"/>
                <field name="graded_count"/>
                <field name="average_marks"/>
                <field name="state"/>
                <field name="is_overdue"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="text-muted o_kanban_record_subtitle">
                                    <field name="assignment_type"/> •
                                    <field name="subject_id"/>
                                </div>
                                <div t-if="record.is_overdue.raw_value"
                                     class="badge text-bg-danger mb-1">
                                    Overdue
                                </div>
                                <ul class="o_kanban_card_content_allow_click">
                                    <li>
                                        <b>Deadline:</b>
                                        <field name="deadline"/>
                                    </li>
                                    <li>
                                        <b>Submissions:</b>
                                        <field name="submission_count"/>
                                        / Graded:
                                        <field name="graded_count"/>
                                    </li>
                                    <li>
                                        <b>Avg Marks:</b>
                                        <field name="average_marks"/>
                                        /
                                        <field name="max_marks"/>
                                    </li>
                                </ul>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="faculty_id"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <span class="badge"
                                              t-attf-class="text-bg-#{
                                                record.state.raw_value == 'published' ? 'primary' :
                                                record.state.raw_value == 'graded'   ? 'success' :
                                                record.state.raw_value == 'closed'   ? 'warning' :
                                                record.state.raw_value == 'cancelled'? 'danger'  : 'secondary'}">
                                            <field name="state"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- SEARCH VIEW                                                         -->
    <!-- ================================================================== -->
    <record id="student_assignment_view_search" model="ir.ui.view">
        <field name="name">student.assignment.view.search</field>
        <field name="model">student.assignment</field>
        <field name="arch" type="xml">
            <search string="Search Assignments">
                <field name="name"/>
                <field name="code"/>
                <field name="subject_id"/>
                <field name="faculty_id"/>
                <field name="batch_id"/>
                <field name="department_id"/>
                <separator/>
                <filter string="Draft" name="draft"
                        domain="[('state','=','draft')]"/>
                <filter string="Published" name="published"
                        domain="[('state','=','published')]"/>
                <filter string="Closed" name="closed"
                        domain="[('state','=','closed')]"/>
                <filter string="Graded" name="graded"
                        domain="[('state','=','graded')]"/>
                <separator/>
                <filter string="Assignment" name="type_assignment"
                        domain="[('assignment_type','=','assignment')]"/>
                <filter string="Homework" name="type_homework"
                        domain="[('assignment_type','=','homework')]"/>
                <filter string="Lab Work" name="type_lab"
                        domain="[('assignment_type','=','lab')]"/>
                <filter string="Quiz" name="type_quiz"
                        domain="[('assignment_type','=','quiz')]"/>
                <separator/>
                <!-- FIXED: overdue uses server-side date, not current_date -->
                <filter string="Overdue" name="overdue"
                        domain="[('deadline','&lt;',context_today()),('state','=','published')]"/>
                <filter string="Due This Week" name="due_this_week"
                        domain="[('deadline','&lt;=',(context_today()+datetime.timedelta(days=7)).strftime('%Y-%m-%d')),
                                  ('deadline','&gt;=',context_today()),
                                  ('state','=','published')]"/>
                <group expand="0" string="Group By">
                    <filter string="Subject" name="group_subject"
                            context="{'group_by':'subject_id'}"/>
                    <filter string="Faculty" name="group_faculty"
                            context="{'group_by':'faculty_id'}"/>
                    <filter string="Batch" name="group_batch"
                            context="{'group_by':'batch_id'}"/>
                    <filter string="Type" name="group_type"
                            context="{'group_by':'assignment_type'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by':'state'}"/>
                    <filter string="Academic Year" name="group_year"
                            context="{'group_by':'academic_year_id'}"/>
                    <filter string="Deadline Month" name="group_deadline"
                            context="{'group_by':'deadline:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- WINDOW ACTION                                                       -->
    <!-- ================================================================== -->
    <record id="action_student_assignment" model="ir.actions.act_window">
        <field name="name">Assignments &amp; Homework</field>
        <field name="res_model">student.assignment</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="student_assignment_view_search"/>
        <field name="context">{'search_default_published': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Assignment or Homework
            </p>
            <p>
                Publish assignments, track submissions batch-wise,
                grade with rubrics, and monitor class averages.
            </p>
        </field>
    </record>

</odoo>