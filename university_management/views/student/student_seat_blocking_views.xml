<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════
         FORM VIEW
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="student_seat_blocking_view_form" model="ir.ui.view">
        <field name="name">student.seat.blocking.view.form</field>
        <field name="model">student.seat.blocking</field>
        <field name="arch" type="xml">
            <form string="Seat Blocking">
                <header>
                    <button name="action_confirm_token_payment"
                            string="Confirm Token Payment"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"
                            confirm="Confirm that the token payment has been received and block the seat?"
                            groups="base.group_user"/>
                    <button name="action_convert_to_admission"
                            string="Convert to Admission"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'token_paid'"
                            confirm="This will create a full admission application. Continue?"
                            groups="base.group_user"/>
                    <button name="action_view_admission"
                            string="View Admission"
                            type="object"
                            invisible="not admission_id"/>
                    <button name="action_mark_expired"
                            string="Mark Expired"
                            type="object"
                            invisible="state not in ['draft', 'token_paid']"
                            groups="base.group_user"/>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="state in ['converted', 'cancelled', 'expired']"
                            confirm="Cancel this seat blocking and release the reserved seat?"/>
                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state in ['draft', 'converted']"
                            groups="base.group_user"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,token_paid,converted"/>
                </header>

                <sheet>
                    <!-- Smart buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_admission"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o"
                                invisible="not admission_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Admission</span>
                                <span class="o_stat_text">Application</span>
                            </div>
                        </button>
                    </div>

                    <!-- Ribbons -->
                    <widget name="web_ribbon" title="Seat Blocked"
                            bg_color="text-bg-success"
                            invisible="state != 'token_paid'"/>
                    <widget name="web_ribbon" title="Converted"
                            bg_color="text-bg-info"
                            invisible="state != 'converted'"/>
                    <widget name="web_ribbon" title="Expired"
                            bg_color="text-bg-warning"
                            invisible="state != 'expired'"/>
                    <widget name="web_ribbon" title="Cancelled"
                            bg_color="text-bg-secondary"
                            invisible="state != 'cancelled'"/>

                    <!-- Title -->
                    <div class="oe_title">
                        <label for="applicant_name" string="Applicant"/>
                        <h1>
                            <field name="applicant_name" placeholder="Full Name" required="1"/>
                        </h1>
                        <h2>
                            <field name="name" readonly="1"/>
                        </h2>
                    </div>

                    <!-- Expiry alert banner -->
                    <div class="alert alert-warning mb-3"
                         invisible="not is_expired or state != 'token_paid'">
                        <i class="fa fa-exclamation-triangle me-2"/>
                        This seat blocking has expired. The reserved seat has been released.
                        Please renew or create a new blocking.
                    </div>
                    <div class="alert alert-info mb-3"
                         invisible="days_remaining &lt;= 0 or days_remaining &gt; 7 or state != 'token_paid'">
                        <i class="fa fa-clock-o me-2"/>
                        Seat reservation expires in <field name="days_remaining" readonly="1"/> days.
                        Convert to admission soon.
                    </div>

                    <!-- Main fields -->
                    <group>
                        <group string="Personal Details">
                            <field name="applicant_name" required="1"/>
                            <field name="email" widget="email"/>
                            <field name="mobile" widget="phone"/>
                            <field name="date_of_birth" widget="date"/>
                            <field name="gender"/>
                        </group>
                        <group string="Program">
                            <field name="program_id"
                                   options="{'no_create': True}"
                                   required="1"/>
                            <field name="department_id" readonly="1"/>
                            <field name="academic_year_id"
                                   options="{'no_create': True}"
                                   required="1"/>
                            <field name="batch_id"
                                   options="{'no_create': True}"
                                   domain="[('program_id', '=', program_id)]"/>
                            <field name="seats_available_at_booking" readonly="1"
                                   invisible="not seats_available_at_booking"/>
                        </group>
                    </group>

                    <group>
                        <group string="Blocking Period">
                            <field name="blocking_date" widget="date" required="1"/>
                            <field name="seat_expiry_date" widget="date" required="1"/>
                            <field name="days_remaining" readonly="1"
                                   invisible="state != 'token_paid'"
                                   widget="integer"
                                   decoration-danger="days_remaining &lt;= 0"
                                   decoration-warning="days_remaining &lt;= 7 and days_remaining &gt; 0"
                                   decoration-success="days_remaining &gt; 7"/>
                        </group>
                        <group string="Counselling">
                            <field name="counsellor_id"
                                   options="{'no_create': True}"/>
                        <field name="enquiry_id" readonly="1"
                               invisible="not enquiry_id"
                               options="{'no_create': True}"/>
                            <field name="entrance_exam_taken"/>
                            <field name="entrance_exam_name"
                                   placeholder="e.g. JEE, KCET, COMEDK"
                                   invisible="not entrance_exam_taken"/>
                            <field name="entrance_exam_score"
                                   placeholder="Score or percentile"
                                   invisible="not entrance_exam_taken"/>
                            <field name="entrance_exam_rank"
                                   invisible="not entrance_exam_taken"/>
                            <field name="entrance_exam_percentile"
                                   invisible="not entrance_exam_taken"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Token Payment Tab -->
                        <page string="Token Payment" name="token_payment">
                            <group>
                                <group string="Payment Details">
                                    <field name="token_amount" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           required="1"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="token_paid" widget="boolean_toggle"/>
                                    <field name="token_payment_mode"
                                           invisible="not token_paid"/>
                                    <field name="token_payment_ref"
                                           invisible="not token_paid"
                                           placeholder="UTR / Transaction ID / Cheque No."/>
                                    <field name="token_payment_date" widget="date"
                                           invisible="not token_paid"/>
                                    <field name="is_adjustable" widget="boolean_toggle"/>
                                </group>
                                <group string="Cheque / DD Details"
                                       invisible="token_payment_mode not in ['cheque', 'dd']">
                                    <field name="token_bank_name"/>
                                    <field name="token_cheque_number"/>
                                    <field name="token_cheque_date" widget="date"/>
                                </group>
                            </group>
                        </page>

                        <!-- Counsellor Notes Tab -->
                        <page string="Notes" name="notes">
                            <group>
                                <field name="counsellor_notes"
                                       placeholder="Notes from the counselling session..."
                                       nolabel="1"/>
                            </group>
                        </page>

                        <!-- Linked Admission Tab -->
                        <page string="Linked Admission" name="linked"
                              invisible="not admission_id">
                            <group>
                                <field name="admission_id" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         LIST VIEW
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="student_seat_blocking_view_list" model="ir.ui.view">
        <field name="name">student.seat.blocking.view.list</field>
        <field name="model">student.seat.blocking</field>
        <field name="arch" type="xml">
            <list string="Seat Blockings"
                  decoration-warning="state == 'token_paid' and days_remaining &lt;= 7 and days_remaining &gt; 0"
                  decoration-danger="state == 'token_paid' and is_expired"
                  decoration-success="state == 'converted'">
                <field name="name"/>
                <field name="applicant_name"/>
                <field name="mobile"/>
                <field name="program_id"/>
                <field name="academic_year_id"/>
                <field name="blocking_date"/>
                <field name="seat_expiry_date"/>
                <field name="token_amount" widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="token_payment_mode"/>
                <field name="counsellor_id"/>
                <field name="days_remaining" string="Days Left"
                       optional="show"
                       decoration-danger="days_remaining &lt;= 0 and state == 'token_paid'"
                       decoration-warning="days_remaining &lt;= 7 and days_remaining &gt; 0"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'token_paid'"
                       decoration-warning="state == 'expired'"
                       decoration-info="state in ['converted', 'draft', 'cancelled']"/>
                <field name="is_expired" column_invisible="1"/>
                <field name="admission_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         KANBAN VIEW
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="student_seat_blocking_view_kanban" model="ir.ui.view">
        <field name="name">student.seat.blocking.view.kanban</field>
        <field name="model">student.seat.blocking</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state"
                    class="o_kanban_small_column"
                    quick_create="false">
                <field name="name"/>
                <field name="applicant_name"/>
                <field name="program_id"/>
                <field name="token_amount"/>
                <field name="currency_id"/>
                <field name="seat_expiry_date"/>
                <field name="days_remaining"/>
                <field name="is_expired"/>
                <field name="state"/>
                <field name="counsellor_id"/>
                <field name="token_payment_mode"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <t t-esc="record.applicant_name.value"/>
                                    </strong>
                                    <small class="o_kanban_record_subtitle text-muted">
                                        <t t-esc="record.name.value"/>
                                    </small>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><i class="fa fa-graduation-cap me-1"/>
                                    <t t-esc="record.program_id.value"/>
                                </div>
                                <div class="mt-1">
                                    <span class="fw-bold">Token: </span>
                                    <field name="token_amount" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                </div>
                                <div class="mt-1 text-muted">
                                    <i class="fa fa-calendar me-1"/>
                                    Valid until: <t t-esc="record.seat_expiry_date.value"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="counsellor_id" widget="many2one_avatar_user"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <t t-if="record.state.raw_value == 'token_paid' and record.days_remaining.raw_value &lt;= 7 and record.days_remaining.raw_value &gt; 0">
                                        <span class="badge text-bg-warning">
                                            <t t-esc="record.days_remaining.value"/> days left
                                        </span>
                                    </t>
                                    <t t-if="record.is_expired.raw_value">
                                        <span class="badge text-bg-danger">Expired</span>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         SEARCH VIEW
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="student_seat_blocking_view_search" model="ir.ui.view">
        <field name="name">student.seat.blocking.view.search</field>
        <field name="model">student.seat.blocking</field>
        <field name="arch" type="xml">
            <search string="Search Seat Blockings">
                <field name="applicant_name"/>
                <field name="name"/>
                <field name="mobile"/>
                <field name="email"/>
                <field name="program_id"/>
                <field name="counsellor_id"/>
                <field name="token_payment_ref"/>

                <filter string="Active (Seat Blocked)" name="filter_active"
                        domain="[('state', '=', 'token_paid')]"/>
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Converted" name="filter_converted"
                        domain="[('state', '=', 'converted')]"/>
                <filter string="Expired" name="filter_expired"
                        domain="[('state', '=', 'expired')]"/>
                <filter string="Expiring This Week" name="filter_expiring"
                        domain="[
                            ('state', '=', 'token_paid'),
                            ('seat_expiry_date', '&lt;=', (context_today() + relativedelta(days=7)).strftime('%Y-%m-%d')),
                            ('seat_expiry_date', '&gt;=', context_today().strftime('%Y-%m-%d'))
                        ]"/>
                <separator/>
                <filter string="My Blockings" name="filter_mine"
                        domain="[('counsellor_id', '=', uid)]"/>

                <group expand="0" string="Group By">
                    <filter string="Program" name="group_program"
                            context="{'group_by': 'program_id'}"/>
                    <filter string="State" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Academic Year" name="group_year"
                            context="{'group_by': 'academic_year_id'}"/>
                    <filter string="Counsellor" name="group_counsellor"
                            context="{'group_by': 'counsellor_id'}"/>
                    <filter string="Blocking Date" name="group_date"
                            context="{'group_by': 'blocking_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         ACTION
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="action_student_seat_blocking" model="ir.actions.act_window">
        <field name="name">Seat Blockings</field>
        <field name="res_model">student.seat.blocking</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No seat blockings yet
            </p>
            <p>
                Block a seat for a prospective student by capturing a token payment.
                Once the full application is complete, convert the blocking to an
                admission application.
            </p>
        </field>
    </record>

</odoo>