<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================== -->
    <!-- FORM                                                                -->
    <!-- ================================================================== -->
    <record id="library_digital_resource_view_form" model="ir.ui.view">
        <field name="name">library.digital.resource.view.form</field>
        <field name="model">library.digital.resource</field>
        <field name="arch" type="xml">
            <form string="Digital Resource">
                <header>
                    <button name="action_publish" type="object"
                            string="Publish" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_archive_resource" type="object"
                            string="Archive" class="btn-default"
                            invisible="state != 'published'"/>
                    <button name="action_reset_draft" type="object"
                            string="Reset to Draft" class="btn-default"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,published,archived"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_access_logs" type="object"
                                class="oe_stat_button" icon="fa-eye">
                            <field name="total_access_count"
                                   widget="statinfo" string="Accesses"/>
                        </button>
                        <button name="action_view_access_logs" type="object"
                                class="oe_stat_button" icon="fa-download">
                            <field name="total_download_count"
                                   widget="statinfo" string="Downloads"/>
                        </button>
                        <button name="action_view_access_logs" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <field name="unique_member_count"
                                   widget="statinfo" string="Unique Members"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Published"
                            bg_color="text-bg-success"
                            invisible="state != 'published'"/>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-secondary"
                            invisible="state != 'archived'"/>

                    <field name="cover_image" widget="image"
                           class="oe_avatar"
                           options="{'preview_image': 'cover_image'}"/>
                    <div class="oe_title">
                        <label for="title"/>
                        <h1><field name="title" placeholder="Resource Title..."/></h1>
                        <h5><field name="subtitle" placeholder="Subtitle..."/></h5>
                        <div class="text-muted">
                            <field name="code" readonly="1"/>
                        </div>
                    </div>

                    <group>
                        <group string="Classification">
                            <field name="resource_type"/>
                            <field name="category_id"/>
                            <field name="collection_id"/>
                            <field name="subject_ids" widget="many2many_tags"/>
                            <field name="tags"/>
                        </group>
                        <group string="Publication">
                            <field name="author_ids" widget="many2many_tags"/>
                            <field name="publisher"/>
                            <field name="publication_year"/>
                            <field name="edition"/>
                            <field name="language"/>
                            <field name="doi"/>
                            <field name="issn"/>
                            <field name="isbn"/>
                        </group>
                    </group>

                    <group>
                        <group string="Content">
                            <field name="content_type"/>
                            <field name="resource_url" widget="url"
                                   invisible="content_type not in ['url','embed']"/>
                            <field name="resource_file"
                                   invisible="content_type != 'file'"
                                   filename="resource_filename"/>
                            <field name="resource_filename"
                                   invisible="content_type != 'file'"/>
                            <field name="file_format"
                                   invisible="content_type != 'file'"/>
                            <field name="file_size_mb"
                                   invisible="content_type != 'file'" readonly="1"/>
                        </group>
                        <group string="Access Control">
                            <field name="access_type"/>
                            <field name="download_allowed"/>
                            <field name="max_downloads_per_member"
                                   invisible="not download_allowed"/>
                            <field name="max_concurrent_access"/>
                            <field name="available_from"/>
                            <field name="available_until"/>
                            <field name="is_available" readonly="1"/>
                        </group>
                    </group>

                    <group string="Embed Code" invisible="content_type != 'embed'">
                        <field name="embed_code" nolabel="1"
                               placeholder="Paste YouTube / NPTEL embed HTML here..."/>
                    </group>

                    <group>
                        <group string="Physical Copy">
                            <field name="physical_book_id"/>
                        </group>
                        <group string="Admin">
                            <field name="added_by" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Abstract / Description">
                            <field name="description"
                                   placeholder="Paste the abstract or description..."/>
                        </page>
                        <page string="Internal Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- LIST                                                                -->
    <!-- ================================================================== -->
    <record id="library_digital_resource_view_list" model="ir.ui.view">
        <field name="name">library.digital.resource.view.list</field>
        <field name="model">library.digital.resource</field>
        <field name="arch" type="xml">
            <list string="Digital Resources"
                  decoration-muted="state == 'archived'"
                  decoration-success="state == 'published' and is_available"
                  decoration-warning="state == 'published' and not is_available">
                <field name="cover_image" widget="image" options="{'size': [32,32]}"/>
                <field name="code"/>
                <field name="title"/>
                <field name="resource_type" widget="badge"
                       decoration-info="resource_type == 'ebook'"
                       decoration-primary="resource_type == 'journal'"
                       decoration-warning="resource_type == 'video'"/>
                <field name="primary_author"/>
                <field name="collection_id"/>
                <field name="category_id"/>
                <field name="access_type" widget="badge"/>
                <field name="content_type" widget="badge"/>
                <field name="total_access_count"/>
                <field name="total_download_count" optional="show"/>
                <field name="available_until" optional="show"/>
                <field name="is_available" widget="boolean"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'published'"
                       decoration-muted="state == 'archived'"/>
            </list>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- KANBAN                                                              -->
    <!-- ================================================================== -->
    <record id="library_digital_resource_view_kanban" model="ir.ui.view">
        <field name="name">library.digital.resource.view.kanban</field>
        <field name="model">library.digital.resource</field>
        <field name="arch" type="xml">
            <kanban default_group_by="resource_type">
                <field name="title"/>
                <field name="resource_type"/>
                <field name="primary_author"/>
                <field name="collection_id"/>
                <field name="access_type"/>
                <field name="total_access_count"/>
                <field name="is_available"/>
                <field name="state"/>
                <field name="cover_image"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-if="record.cover_image.raw_value"
                                     t-att-src="kanban_image('library.digital.resource', 'cover_image', record.id.raw_value)"
                                     class="o_image_64_cover" alt="Cover"/>
                                <span t-else="" class="fa fa-book fa-3x text-muted mt-3 d-block text-center"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong><field name="title"/></strong>
                                <div class="text-muted">
                                    <field name="primary_author"/>
                                </div>
                                <div>
                                    <field name="collection_id"/>
                                </div>
                                <div class="mt-1">
                                    <span t-attf-class="badge text-bg-#{
                                        record.access_type.raw_value == 'open' ? 'success' :
                                        record.access_type.raw_value == 'member' ? 'primary' :
                                        record.access_type.raw_value == 'restricted' ? 'warning' : 'secondary'}">
                                        <field name="access_type"/>
                                    </span>
                                    <span t-if="not record.is_available.raw_value"
                                          class="badge text-bg-danger ms-1">Unavailable</span>
                                </div>
                                <div class="text-muted mt-1">
                                    <i class="fa fa-eye"/> <field name="total_access_count"/> views
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- SEARCH                                                              -->
    <!-- ================================================================== -->
    <record id="library_digital_resource_view_search" model="ir.ui.view">
        <field name="name">library.digital.resource.view.search</field>
        <field name="model">library.digital.resource</field>
        <field name="arch" type="xml">
            <search string="Search Digital Resources">
                <field name="title"/>
                <field name="primary_author"/>
                <field name="tags"/>
                <field name="doi"/>
                <field name="isbn"/>
                <field name="collection_id"/>
                <field name="category_id"/>
                <field name="subject_ids"/>
                <separator/>
                <filter string="Published" name="published"
                        domain="[('state','=','published')]"/>
                <filter string="Available Now" name="available"
                        domain="[('is_available','=',True)]"/>
                <filter string="Open Access" name="open"
                        domain="[('access_type','=','open')]"/>
                <filter string="With Download" name="downloadable"
                        domain="[('download_allowed','=',True)]"/>
                <separator/>
                <filter string="E-Books" name="ebooks"
                        domain="[('resource_type','=','ebook')]"/>
                <filter string="Journals" name="journals"
                        domain="[('resource_type','=','journal')]"/>
                <filter string="Videos" name="videos"
                        domain="[('resource_type','=','video')]"/>
                <filter string="Theses" name="theses"
                        domain="[('resource_type','=','thesis')]"/>
                <group expand="0" string="Group By">
                    <filter string="Resource Type" name="group_type"
                            context="{'group_by':'resource_type'}"/>
                    <filter string="Collection" name="group_collection"
                            context="{'group_by':'collection_id'}"/>
                    <filter string="Category" name="group_category"
                            context="{'group_by':'category_id'}"/>
                    <filter string="Access Level" name="group_access"
                            context="{'group_by':'access_type'}"/>
                    <filter string="Language" name="group_lang"
                            context="{'group_by':'language'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- ACTION                                                              -->
    <!-- ================================================================== -->
    <record id="action_library_digital_resource" model="ir.actions.act_window">
        <field name="name">Digital Resources</field>
        <field name="res_model">library.digital.resource</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="library_digital_resource_view_search"/>
        <field name="context">{'search_default_published': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first Digital Resource
            </p>
            <p>Upload e-books, link to journals, embed video lectures, and more.</p>
        </field>
    </record>

</odoo>