<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================== -->
    <!-- FORM                                                                -->
    <!-- ================================================================== -->
    <record id="library_digital_collection_view_form" model="ir.ui.view">
        <field name="name">library.digital.collection.view.form</field>
        <field name="model">library.digital.collection</field>
        <field name="arch" type="xml">
            <form string="Digital Collection">
                <header>
                    <field name="is_subscription_active" widget="boolean_toggle"
                           readonly="1" string="Subscription Active"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_resources" type="object"
                                class="oe_stat_button" icon="fa-database">
                            <field name="resource_count"
                                   widget="statinfo" string="Resources"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Subscription Expired"
                            bg_color="text-bg-danger"
                            invisible="not is_subscribed or is_subscription_active"/>
                    <widget name="web_ribbon" title="Open Access"
                            bg_color="text-bg-success"
                            invisible="is_subscribed"/>

                    <field name="logo" widget="image"
                           class="oe_avatar" options="{'preview_image': 'logo'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Collection Name..."/></h1>
                        <h4><field name="code" placeholder="Short code..."/></h4>
                    </div>

                    <group>
                        <group string="Collection Details">
                            <field name="collection_type"/>
                            <field name="provider"/>
                            <field name="access_type"/>
                        </group>
                        <group string="Subscription">
                            <field name="is_subscribed"/>
                            <field name="subscription_start"
                                   invisible="not is_subscribed"/>
                            <field name="subscription_end"
                                   invisible="not is_subscribed"/>
                            <field name="is_subscription_active"
                                   invisible="not is_subscribed"/>
                        </group>
                    </group>

                    <group>
                        <group string="Access URLs">
                            <field name="website_url" widget="url"/>
                            <field name="access_url" widget="url"/>
                        </group>
                        <group string="Contact">
                            <field name="contact_person"/>
                            <field name="contact_email" widget="email"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description">
                            <field name="description"
                                   placeholder="Describe this collection..."/>
                        </page>
                        <page string="Resources">
                            <field name="resource_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="title"/>
                                    <field name="resource_type" widget="badge"/>
                                    <field name="primary_author"/>
                                    <field name="access_type" widget="badge"/>
                                    <field name="total_access_count"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'published'"
                                           decoration-muted="state == 'draft'"
                                           decoration-warning="state == 'archived'"/>
                                </list>
                            </field>
                        </page>
                        <page string="License / Terms">
                            <field name="license_note"
                                   placeholder="Paste license and usage terms here..."/>
                        </page>
                        <page string="Internal Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- LIST                                                                -->
    <!-- ================================================================== -->
    <record id="library_digital_collection_view_list" model="ir.ui.view">
        <field name="name">library.digital.collection.view.list</field>
        <field name="model">library.digital.collection</field>
        <field name="arch" type="xml">
            <list string="Digital Collections"
                  decoration-muted="not is_subscribed or not is_subscription_active"
                  decoration-success="is_subscription_active">
                <field name="logo" widget="image" options="{'size': [32, 32]}"/>
                <field name="code"/>
                <field name="name"/>
                <field name="collection_type" widget="badge"/>
                <field name="provider"/>
                <field name="access_type" widget="badge"/>
                <field name="resource_count"/>
                <field name="subscription_end"/>
                <field name="is_subscribed" widget="boolean"/>
                <field name="is_subscription_active" widget="boolean"/>
            </list>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- SEARCH                                                              -->
    <!-- ================================================================== -->
    <record id="library_digital_collection_view_search" model="ir.ui.view">
        <field name="name">library.digital.collection.view.search</field>
        <field name="model">library.digital.collection</field>
        <field name="arch" type="xml">
            <search string="Search Collections">
                <field name="name"/>
                <field name="provider"/>
                <field name="code"/>
                <filter string="Subscribed" name="subscribed"
                        domain="[('is_subscribed','=',True),('is_subscription_active','=',True)]"/>
                <filter string="Open Access" name="open"
                        domain="[('is_subscribed','=',False)]"/>
                <filter string="Expiring Soon" name="expiring"
                        domain="[('subscription_end','&lt;=',(context_today()+datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_type"
                            context="{'group_by':'collection_type'}"/>
                    <filter string="Access Method" name="group_access"
                            context="{'group_by':'access_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- ACTION                                                              -->
    <!-- ================================================================== -->
    <record id="action_library_digital_collection" model="ir.actions.act_window">
        <field name="name">Digital Collections</field>
        <field name="res_model">library.digital.collection</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="library_digital_collection_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first Digital Collection or Database
            </p>
        </field>
    </record>

</odoo>