<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================== -->
    <!-- Digital Access Log                                                  -->
    <!-- ================================================================== -->

    <record id="library_digital_access_view_list" model="ir.ui.view">
        <field name="name">library.digital.access.view.list</field>
        <field name="model">library.digital.access</field>
        <field name="arch" type="xml">
            <list string="Digital Access Logs" create="false" edit="false"
                  decoration-primary="access_type == 'download'"
                  decoration-info="access_type == 'view'">
                <field name="access_date"/>
                <field name="resource_id"/>
                <field name="resource_type" widget="badge" optional="show"/>
                <field name="collection_id" optional="show"/>
                <field name="member_id"/>
                <field name="member_name"/>
                <field name="member_type" widget="badge" optional="show"/>
                <field name="access_type" widget="badge"
                       decoration-primary="access_type == 'download'"
                       decoration-info="access_type == 'view'"
                       decoration-warning="access_type == 'stream'"/>
                <field name="duration_minutes" optional="show"/>
                <field name="device_type" optional="show"/>
                <field name="ip_address" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="library_digital_access_view_form" model="ir.ui.view">
        <field name="name">library.digital.access.view.form</field>
        <field name="model">library.digital.access</field>
        <field name="arch" type="xml">
            <form string="Access Log" create="false">
                <sheet>
                    <group>
                        <group string="Resource">
                            <field name="resource_id"/>
                            <field name="resource_type"/>
                            <field name="collection_id"/>
                        </group>
                        <group string="Member">
                            <field name="member_id"/>
                            <field name="member_name"/>
                            <field name="member_type"/>
                        </group>
                    </group>
                    <group>
                        <group string="Access Details">
                            <field name="access_date"/>
                            <field name="access_type"/>
                            <field name="duration_minutes"/>
                        </group>
                        <group string="Device / Network">
                            <field name="device_type"/>
                            <field name="ip_address"/>
                            <field name="user_agent"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="library_digital_access_view_search" model="ir.ui.view">
        <field name="name">library.digital.access.view.search</field>
        <field name="model">library.digital.access</field>
        <field name="arch" type="xml">
            <search string="Search Access Logs">
                <field name="resource_id"/>
                <field name="member_id"/>
                <field name="member_name"/>
                <field name="collection_id"/>
                <separator/>
                <filter string="Views" name="views"
                        domain="[('access_type','=','view')]"/>
                <filter string="Downloads" name="downloads"
                        domain="[('access_type','=','download')]"/>
                <filter string="Streams" name="streams"
                        domain="[('access_type','=','stream')]"/>
                <separator/>
                <filter string="Today" name="today"
                        domain="[('access_date','&gt;=',datetime.datetime.now().replace(hour=0,minute=0,second=0).strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <filter string="This Month" name="this_month"
                        domain="[('access_date','&gt;=',context_today().strftime('%Y-%m-01'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Resource" name="group_resource"
                            context="{'group_by':'resource_id'}"/>
                    <filter string="Member" name="group_member"
                            context="{'group_by':'member_id'}"/>
                    <filter string="Collection" name="group_collection"
                            context="{'group_by':'collection_id'}"/>
                    <filter string="Access Type" name="group_type"
                            context="{'group_by':'access_type'}"/>
                    <filter string="Date" name="group_date"
                            context="{'group_by':'access_date:day'}"/>
                    <filter string="Month" name="group_month"
                            context="{'group_by':'access_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_library_digital_access" model="ir.actions.act_window">
        <field name="name">Digital Access Logs</field>
        <field name="res_model">library.digital.access</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="library_digital_access_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No access logs yet</p>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- OPAC Search Log                                                     -->
    <!-- ================================================================== -->

    <record id="library_opac_search_log_view_list" model="ir.ui.view">
        <field name="name">library.opac.search.log.view.list</field>
        <field name="model">library.opac.search.log</field>
        <field name="arch" type="xml">
            <list string="OPAC Search Log" create="false" edit="false">
                <field name="search_date"/>
                <field name="query"/>
                <field name="member_name" optional="show"/>
                <field name="is_anonymous" widget="boolean"/>
                <field name="results_count"/>
                <field name="filter_type" optional="show"/>
                <field name="filter_category" optional="show"/>
                <field name="clicked_resource_id" optional="show"/>
                <field name="clicked_book_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="library_opac_search_log_view_search" model="ir.ui.view">
        <field name="name">library.opac.search.log.view.search</field>
        <field name="model">library.opac.search.log</field>
        <field name="arch" type="xml">
            <search string="Search OPAC Logs">
                <field name="query"/>
                <field name="member_name"/>
                <filter string="Anonymous" name="anon"
                        domain="[('is_anonymous','=',True)]"/>
                <filter string="No Results" name="no_results"
                        domain="[('results_count','=',0)]"/>
                <filter string="This Month" name="this_month"
                        domain="[('search_date','&gt;=',context_today().strftime('%Y-%m-01'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Query" name="group_query"
                            context="{'group_by':'query'}"/>
                    <filter string="Date" name="group_date"
                            context="{'group_by':'search_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_library_opac_search_log" model="ir.actions.act_window">
        <field name="name">OPAC Search Analytics</field>
        <field name="res_model">library.opac.search.log</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="library_opac_search_log_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No searches recorded yet</p>
        </field>
    </record>

</odoo>