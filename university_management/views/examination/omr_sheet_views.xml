<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- OMR Sheet — Form -->
    <!-- ============================================================ -->
    <record id="view_omr_sheet_form" model="ir.ui.view">
        <field name="name">exam.omr.sheet.form</field>
        <field name="model">exam.omr.sheet</field>
        <field name="arch" type="xml">
            <form string="OMR Sheet">
                <header>
                    <button name="action_generate_pdf" type="object"
                            string="Generate OMR PDF" class="btn-primary"
                            invisible="state not in ('draft',)"/>
                    <button name="action_download" type="object"
                            string="Download OMR Sheet" class="btn-primary"
                            invisible="state not in ('generated', 'downloaded')"/>
                    <button name="action_reset_draft" type="object"
                            string="Reset to Draft"
                            class="btn-danger"
                            invisible="state == 'draft'"
                            confirm="Reset this OMR sheet to draft?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,generated,downloaded,scanned"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_scan" type="object"
                                class="oe_stat_button text-info"
                                icon="fa-search"
                                invisible="not scan_count">
                            <field name="scan_count" widget="statinfo" string="Scan"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Generated" bg_color="text-bg-info"
                            invisible="state != 'generated'"/>
                    <widget name="web_ribbon" title="Downloaded" bg_color="text-bg-success"
                            invisible="state != 'downloaded'"/>
                    <widget name="web_ribbon" title="Scanned" bg_color="text-bg-success"
                            invisible="state != 'scanned'"/>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Student Details">
                            <field name="serial_number"/>
                            <field name="student_id"/>
                            <field name="registration_number"/>
                            <field name="student_name"/>
                            <field name="hall_ticket_number"/>
                            <field name="program_id"/>
                            <field name="department_id"/>
                            <field name="branch_name"/>
                        </group>
                        <group string="Exam Details">
                            <field name="examination_id"/>
                            <field name="exam_month_year" placeholder="e.g., AUGUST 2026"/>
                            <field name="exam_date"/>
                            <field name="subject_id"/>
                            <field name="subject_code"/>
                            <field name="subject_name"/>
                            <field name="omr_template_id"/>
                        </group>
                    </group>

                    <group string="Barcode">
                        <field name="barcode_data"/>
                        <field name="barcode_image" widget="image" class="oe_avatar"/>
                    </group>

                    <group string="Student Photo">
                        <field name="student_photo" widget="image" class="oe_avatar"/>
                    </group>

                    <group string="Generated PDF"
                           invisible="not omr_pdf">
                        <field name="omr_pdf" filename="omr_pdf_filename"/>
                        <field name="omr_pdf_filename" invisible="1"/>
                        <field name="download_count"/>
                    </group>
                </sheet>
                <field name="message_main_attachment_id" invisible="1"/>
                <div class="o_attachment_preview"/>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- OMR Sheet — List -->
    <record id="view_omr_sheet_list" model="ir.ui.view">
        <field name="name">exam.omr.sheet.list</field>
        <field name="model">exam.omr.sheet</field>
        <field name="arch" type="xml">
            <list>
                <field name="serial_number"/>
                <field name="registration_number"/>
                <field name="student_name"/>
                <field name="examination_id"/>
                <field name="subject_code"/>
                <field name="subject_name"/>
                <field name="omr_template_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state in ('generated', 'downloaded')"
                       decoration-muted="state == 'scanned'"/>
            </list>
        </field>
    </record>

    <!-- OMR Sheet — Kanban -->
    <record id="view_omr_sheet_kanban" model="ir.ui.view">
        <field name="name">exam.omr.sheet.kanban</field>
        <field name="model">exam.omr.sheet</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state" quick_create="false">
                <field name="id"/>
                <field name="serial_number"/>
                <field name="student_name"/>
                <field name="registration_number"/>
                <field name="hall_ticket_number"/>
                <field name="examination_id"/>
                <field name="subject_code"/>
                <field name="subject_name"/>
                <field name="state"/>
                <field name="student_photo"/>

                <progressbar field="state"
                             colors='{"draft": "secondary", "generated": "info", "downloaded": "success", "scanned": "success"}'/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_card_content">
                                <div class="row">
                                    <div class="col-3">
                                        <img t-att-src="kanban_image('exam.omr.sheet', 'student_photo', record.id.raw_value)"
                                             alt="Student"
                                             class="o_image_64_max rounded"/>
                                    </div>
                                    <div class="col-9">
                                        <strong class="o_kanban_record_title">
                                            <field name="student_name"/>
                                        </strong>
                                        <span t-att-class="'badge float-end text-bg-' + (record.state.raw_value in ['generated', 'downloaded'] ? 'success' : record.state.raw_value == 'scanned' ? 'secondary' : 'info')">
                                            <field name="state"/>
                                        </span>
                                        <div class="text-muted">
                                            <field name="registration_number"/>
                                        </div>
                                        <div class="mt-1">
                                            <i class="fa fa-hashtag text-primary"/>
                                            <field name="serial_number"/>
                                        </div>
                                        <div class="mt-1" t-if="record.subject_name.raw_value">
                                            <i class="fa fa-book text-info"/>
                                            <field name="subject_code"/> — <field name="subject_name"/>
                                        </div>
                                        <div class="mt-1" t-if="record.examination_id.raw_value">
                                            <i class="fa fa-graduation-cap text-warning"/>
                                            <field name="examination_id"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="o_kanban_card_footer">
                                <div class="o_kanban_footer_left">
                                    <!-- Empty for future use -->
                                </div>
                                <div class="o_kanban_footer_right">
                                    <field name="activity_ids" widget="kanban_activity"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- OMR Sheet — Search -->
    <record id="view_omr_sheet_search" model="ir.ui.view">
        <field name="name">exam.omr.sheet.search</field>
        <field name="model">exam.omr.sheet</field>
        <field name="arch" type="xml">
            <search string="OMR Sheets">
                <field name="serial_number"/>
                <field name="registration_number"/>
                <field name="student_name"/>
                <field name="student_id"/>
                <field name="examination_id"/>
                <field name="subject_id"/>
                <filter name="draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="generated" string="Generated"
                        domain="[('state', '=', 'generated')]"/>
                <filter name="scanned" string="Scanned"
                        domain="[('state', '=', 'scanned')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_exam" string="Examination"
                            context="{'group_by': 'examination_id'}"/>
                    <filter name="group_subject" string="Subject"
                            context="{'group_by': 'subject_id'}"/>
                    <filter name="group_template" string="Template"
                            context="{'group_by': 'omr_template_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
                <searchpanel>
                    <field name="examination_id" string="Examination"
                           select="multi"
                           icon="fa-graduation-cap"/>
                    <field name="subject_id" string="Subject"
                           select="multi"
                           icon="fa-book"/>
                    <field name="omr_template_id" string="Template"
                           select="multi"
                           icon="fa-file-text-o"/>
                    <field name="state" string="Status"
                           select="multi"
                           icon="fa-filter"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_omr_sheet" model="ir.actions.act_window">
        <field name="name">OMR Sheets</field>
        <field name="res_model">exam.omr.sheet</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Generate OMR Sheets
            </p>
            <p>Each student gets an OMR sheet with a barcode encoding their registration number and details. Download and attach to the answer booklet.</p>
        </field>
    </record>

</odoo>