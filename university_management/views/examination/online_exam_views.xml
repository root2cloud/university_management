<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="online_exam_view_form" model="ir.ui.view">
        <field name="name">online.exam.view.form</field>
        <field name="model">online.exam</field>
        <field name="arch" type="xml">
            <form string="Online Exam">
                <header>
                    <button name="action_publish" type="object" string="Publish"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_set_ongoing" type="object" string="Set Ongoing"
                            class="oe_highlight"
                            invisible="state != 'published'"/>
                    <button name="action_close" type="object" string="Close Exam"
                            class="oe_highlight"
                            invisible="state != 'ongoing'"/>
                    <button name="action_auto_evaluate_wizard" type="object"
                            string="Auto Evaluate Attempts"
                            class="btn-secondary"
                            invisible="state == 'draft'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            class="btn-default"
                            invisible="state == 'draft'"
                            confirm="Reset this online exam to draft? All attempts will remain."/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,published,ongoing,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_attempts" type="object"
                                class="oe_stat_button" icon="fa-pencil-square-o">
                            <field name="attempt_count" widget="statinfo" string="Attempts"/>
                        </button>
                        <button name="%(action_mcq_question)d" type="action"
                                class="oe_stat_button" icon="fa-question-circle"
                                context="{'search_default_bank_id': False}">
                            <field name="question_count" widget="statinfo" string="Questions"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Mid-term OS Online Test"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Exam Details">
                            <field name="code" readonly="1"/>
                            <field name="examination_id"/>
                            <field name="subject_id"/>
                            <field name="academic_year_id" readonly="1"/>
                            <field name="semester_id" readonly="1"/>
                        </group>
                        <group string="Schedule &amp; Marks">
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="duration_minutes"/>
                            <field name="total_marks" readonly="1"/>
                            <field name="passing_marks"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Questions">
                            <group>
                                <group>
                                    <field name="shuffle_questions" widget="boolean_toggle"/>
                                    <field name="shuffle_options" widget="boolean_toggle"/>
                                    <field name="negative_marking" widget="boolean_toggle"/>
                                </group>
                                <group>
                                    <field name="show_result_immediately" widget="boolean_toggle"/>
                                    <field name="allow_review" widget="boolean_toggle"/>
                                    <field name="allow_multiple_attempts" widget="boolean_toggle"/>
                                    <field name="max_attempts"
                                           invisible="not allow_multiple_attempts"/>
                                </group>
                            </group>
                            <separator string="Selected Questions"/>
                            <field name="question_ids" widget="many2many">
                                <list>
                                    <field name="name" string="Code"/>
                                    <field name="question_type" string="Type" widget="badge"
                                           decoration-info="question_type == 'mcq'"
                                           decoration-warning="question_type == 'true_false'"
                                           decoration-success="question_type == 'multi_select'"
                                           decoration-danger="question_type == 'short_answer'"/>
                                    <field name="subject_id"/>
                                    <field name="difficulty" widget="priority"/>
                                    <field name="marks"/>
                                    <field name="bank_id"/>
                                </list>
                            </field>
                        </page>

                        <page string="Audience">
                            <group>
                                <field name="program_ids" widget="many2many_tags"/>
                                <field name="batch_ids" widget="many2many_tags"/>
                            </group>
                        </page>

                        <page string="Instructions">
                            <field name="instructions" widget="html"
                                   placeholder="Enter exam instructions for students…"/>
                        </page>

                        <page string="Attempts" invisible="attempt_count == 0">
                            <field name="attempt_ids" readonly="1">
                                <list decoration-success="result == 'pass'"
                                       decoration-danger="result == 'fail'"
                                       decoration-muted="state == 'expired'">
                                    <field name="student_id"/>
                                    <field name="registration_number"/>
                                    <field name="start_datetime"/>
                                    <field name="submit_datetime"/>
                                    <field name="total_score"/>
                                    <field name="max_score"/>
                                    <field name="percentage" string="%"/>
                                    <field name="result" widget="badge"
                                           decoration-success="result == 'pass'"
                                           decoration-danger="result == 'fail'"
                                           decoration-warning="result == 'pending'"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'in_progress'"
                                           decoration-success="state == 'evaluated'"
                                           decoration-warning="state == 'submitted'"
                                           decoration-danger="state == 'expired'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="online_exam_view_list" model="ir.ui.view">
        <field name="name">online.exam.view.list</field>
        <field name="model">online.exam</field>
        <field name="arch" type="xml">
            <list string="Online Exams"
                  decoration-success="state == 'closed'"
                  decoration-info="state == 'ongoing'"
                  decoration-warning="state == 'published'"
                  decoration-muted="not active">
                <field name="code"/>
                <field name="name"/>
                <field name="examination_id"/>
                <field name="subject_id"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="duration_minutes" string="Duration (min)"/>
                <field name="question_count" string="Questions"/>
                <field name="total_marks" string="Marks"/>
                <field name="attempt_count" string="Attempts"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'published'"
                       decoration-success="state == 'ongoing'"
                       decoration-danger="state == 'closed'"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="online_exam_view_search" model="ir.ui.view">
        <field name="name">online.exam.view.search</field>
        <field name="model">online.exam</field>
        <field name="arch" type="xml">
            <search string="Search Online Exams">
                <field name="name"/>
                <field name="code"/>
                <field name="subject_id"/>
                <field name="examination_id"/>
                <separator/>
                <filter string="Draft" name="f_draft" domain="[('state','=','draft')]"/>
                <filter string="Published" name="f_published" domain="[('state','=','published')]"/>
                <filter string="Ongoing" name="f_ongoing" domain="[('state','=','ongoing')]"/>
                <filter string="Closed" name="f_closed" domain="[('state','=','closed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Examination" name="grp_exam"
                            context="{'group_by': 'examination_id'}"/>
                    <filter string="Subject" name="grp_subject"
                            context="{'group_by': 'subject_id'}"/>
                    <filter string="Status" name="grp_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_online_exam" model="ir.actions.act_window">
        <field name="name">Online Exams</field>
        <field name="res_model">online.exam</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="online_exam_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first online exam!</p>
            <p>Set up MCQ-based online examinations that students can take through the portal.</p>
        </field>
    </record>

</odoo>