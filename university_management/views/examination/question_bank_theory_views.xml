<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Theory Question Bank — Form -->
    <!-- ============================================================ -->
    <record id="view_theory_question_bank_form" model="ir.ui.view">
        <field name="name">exam.theory.question.bank.form</field>
        <field name="model">exam.theory.question.bank</field>
        <field name="arch" type="xml">
            <form string="Theory Question Bank">
                <header>
                    <button name="action_import_questions" type="object"
                            string="Extract Questions" class="oe_highlight"
                            invisible="not import_file"
                            confirm="This will replace any existing questions in this bank with what's parsed from the file. Continue?"/>
                    <button name="action_submit_review" type="object" string="Submit for Review"
                            invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_approve" type="object" string="Approve"
                            invisible="state != 'review'" class="oe_highlight"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"
                            confirm="Are you sure you want to reset this question bank to draft?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,review,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_questions" type="object"
                                class="oe_stat_button" icon="fa-question-circle">
                            <field name="question_count" widget="statinfo"
                                   string="Questions"/>
                        </button>
                        <button name="action_view_easy" type="object"
                                class="oe_stat_button" icon="fa-circle-o">
                            <field name="easy_count" widget="statinfo" string="Easy"/>
                        </button>
                        <button name="action_view_medium" type="object"
                                class="oe_stat_button" icon="fa-adjust">
                            <field name="medium_count" widget="statinfo" string="Medium"/>
                        </button>
                        <button name="action_view_hard" type="object"
                                class="oe_stat_button" icon="fa-dot-circle-o">
                            <field name="hard_count" widget="statinfo" string="Hard"/>
                        </button>
                    </div>

                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Under Review" bg_color="text-bg-warning"
                            invisible="state != 'review'"/>
                    <widget name="web_ribbon" title="Approved" bg_color="text-bg-success"
                            invisible="state != 'approved'"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>

                    <group>
                        <group>
                            <field name="name" placeholder="e.g., Digital Image Processing QB"/>
                            <field name="code"/>
                            <field name="regulation" placeholder="e.g., R20, R22, R23"/>
                            <field name="faculty_id"/>
                        </group>
                        <group>
                            <field name="subject_id"/>
                            <field name="department_id"/>
                            <field name="program_id"/>
                            <field name="semester_id"/>
                        </group>
                    </group>
                    <group string="Import Questions">
                        <field name="import_file" filename="import_filename"/>
                        <field name="import_filename" invisible="1"/>
                        <field name="import_log" readonly="1" invisible="not import_log"/>
                    </group>
                    <notebook>
                        <page string="Questions" name="questions">
                            <field name="question_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="unit"/>
                                    <field name="question_number"/>
                                    <field name="sub_part"/>
                                    <field name="question_text"/>
                                    <field name="marks"/>
                                    <field name="co_level"/>
                                    <field name="rbt_level"/>
                                    <field name="difficulty"/>
                                    <field name="used_count" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Theory Question Bank — List -->
    <record id="view_theory_question_bank_list" model="ir.ui.view">
        <field name="name">exam.theory.question.bank.list</field>
        <field name="model">exam.theory.question.bank</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="subject_id"/>
                <field name="department_id"/>
                <field name="regulation"/>
                <field name="faculty_id"/>
                <field name="question_count"/>
                <field name="easy_count"/>
                <field name="medium_count"/>
                <field name="hard_count"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'review'"
                       decoration-success="state == 'approved'"/>
            </list>
        </field>
    </record>

    <!-- Theory Question Bank — Search -->
    <record id="view_theory_question_bank_search" model="ir.ui.view">
        <field name="name">exam.theory.question.bank.search</field>
        <field name="model">exam.theory.question.bank</field>
        <field name="arch" type="xml">
            <search string="Question Banks">
                <field name="name"/>
                <field name="code"/>
                <field name="subject_id"/>
                <field name="department_id"/>
                <field name="regulation"/>
                <field name="faculty_id"/>
                <filter name="approved" string="Approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter name="draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_subject" string="Subject"
                            context="{'group_by': 'subject_id'}"/>
                    <filter name="group_department" string="Department"
                            context="{'group_by': 'department_id'}"/>
                    <filter name="group_regulation" string="Regulation"
                            context="{'group_by': 'regulation'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
                <searchpanel>
                    <field name="subject_id" string="Subject"
                           select="multi"
                           icon="fa-book"/>
                    <field name="department_id" string="Department"
                           select="multi"
                           icon="fa-building"/>
                    <field name="program_id" string="Program"
                           select="multi"
                           icon="fa-graduation-cap"/>
                    <field name="state" string="Status"
                           select="multi"
                           icon="fa-filter"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Theory Question Bank — Kanban -->
    <record id="view_theory_question_bank_kanban" model="ir.ui.view">
        <field name="name">exam.theory.question.bank.kanban</field>
        <field name="model">exam.theory.question.bank</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state" quick_create="false">
                <field name="id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="subject_id"/>
                <field name="department_id"/>
                <field name="regulation"/>
                <field name="faculty_id"/>
                <field name="question_count"/>
                <field name="easy_count"/>
                <field name="medium_count"/>
                <field name="hard_count"/>
                <field name="state"/>

                <progressbar field="state"
                             colors='{"draft": "secondary", "review": "warning", "approved": "success"}'/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_card_header">
                                <div class="o_kanban_card_header_title">
                                    <div class="o_primary">
                                        <strong>
                                            <field name="name"/>
                                        </strong>
                                        <span t-att-class="'badge ms-2 text-bg-' + (record.state.raw_value == 'approved' ? 'success' : record.state.raw_value == 'review' ? 'warning' : 'info')">
                                            <field name="state"/>
                                        </span>
                                    </div>
                                    <div class="text-muted">
                                        <field name="code"/> — <field name="subject_id"/>
                                    </div>
                                </div>
                            </div>

                            <div class="o_kanban_card_content">
                                <div class="row mb-2">
                                    <div class="col-6" t-if="record.department_id.raw_value">
                                        <i class="fa fa-building text-primary"/>
                                        <field name="department_id"/>
                                    </div>
                                    <div class="col-6" t-if="record.faculty_id.raw_value">
                                        <i class="fa fa-user text-info"/>
                                        <field name="faculty_id"/>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-3">
                                        <strong><field name="question_count"/></strong>
                                        <div class="text-muted"><small>Total</small></div>
                                    </div>
                                    <div class="col-3">
                                        <span class="text-success"><field name="easy_count"/></span>
                                        <div class="text-muted"><small>Easy</small></div>
                                    </div>
                                    <div class="col-3">
                                        <span class="text-warning"><field name="medium_count"/></span>
                                        <div class="text-muted"><small>Medium</small></div>
                                    </div>
                                    <div class="col-3">
                                        <span class="text-danger"><field name="hard_count"/></span>
                                        <div class="text-muted"><small>Hard</small></div>
                                    </div>
                                </div>
                            </div>

                            <div class="o_kanban_card_footer">
                                <div class="o_kanban_footer_left">
                                    <span t-if="record.regulation.raw_value">
                                        <field name="regulation"/>
                                    </span>
                                </div>
                                <div class="o_kanban_footer_right">
                                    <field name="activity_ids" widget="kanban_activity"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="action_theory_question_bank" model="ir.actions.act_window">
        <field name="name">Theory Question Banks</field>
        <field name="res_model">exam.theory.question.bank</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Theory Question Bank
            </p>
            <p>Faculty can upload descriptive / theory questions organised by unit, CO, and RBT level.</p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Theory Question — Form -->
    <!-- ============================================================ -->
    <record id="view_theory_question_form" model="ir.ui.view">
        <field name="name">exam.theory.question.form</field>
        <field name="model">exam.theory.question</field>
        <field name="arch" type="xml">
            <form string="Theory Question">
                <sheet>
                    <group>
                        <group>
                            <field name="bank_id"/>
                            <field name="unit" placeholder="e.g., UNIT-1"/>
                            <field name="question_number"/>
                            <field name="sub_part"/>
                        </group>
                        <group>
                            <field name="marks"/>
                            <field name="co_level" placeholder="e.g., CO1"/>
                            <field name="rbt_level"/>
                            <field name="difficulty"/>
                            <field name="used_count" readonly="1"/>
                        </group>
                    </group>
                    <group string="Question">
                        <field name="question_text" nolabel="1"
                               placeholder="Enter the question text here …"/>
                    </group>
                    <group string="Question Image">
                        <field name="question_image" widget="image" nolabel="1"/>
                    </group>
                    <group string="Model Answer / Key Points">
                        <field name="model_answer" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Theory Question — List -->
    <record id="view_theory_question_list" model="ir.ui.view">
        <field name="name">exam.theory.question.list</field>
        <field name="model">exam.theory.question</field>
        <field name="arch" type="xml">
            <list>
                <field name="unit"/>
                <field name="question_number"/>
                <field name="sub_part"/>
                <field name="question_text"/>
                <field name="marks"/>
                <field name="co_level"/>
                <field name="rbt_level"/>
                <field name="difficulty"/>
                <field name="bank_id"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_theory_question" model="ir.actions.act_window">
        <field name="name">Theory Questions</field>
        <field name="res_model">exam.theory.question</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>