<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════
         FORM VIEW
         Changes:
         - Added batch_id field (new computed field from iic_attendance.py)
         - Added registration_number for quick lookup
         - Added participant_type alongside attendee_type
         - department_id is now readonly (auto-filled from student)
         - batch_id is now readonly (auto-filled from student)
         - Added academic_year_id relay from event for context
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="iic_attendance_view_form" model="ir.ui.view">
        <field name="name">iic.attendance.view.form</field>
        <field name="model">iic.attendance</field>
        <field name="arch" type="xml">
            <form string="IIC Attendance">
                <sheet>
                    <!-- Status banner at top -->
                    <widget name="web_ribbon"
                            title="Present"
                            bg_color="bg-success"
                            invisible="status != 'present'"/>
                    <widget name="web_ribbon"
                            title="Absent"
                            bg_color="bg-danger"
                            invisible="status != 'absent'"/>
                    <widget name="web_ribbon"
                            title="Checked In"
                            bg_color="bg-warning"
                            invisible="status != 'checked_in'"/>

                    <group>
                        <!-- ── Event & Classification ── -->
                        <group string="Event">
                            <field name="event_id" options="{'no_create': True}"/>
                            <field name="attendee_type" widget="radio"/>
                            <field name="participant_type" widget="radio"/>
                        </group>

                        <!-- ── Attendee Identity ── -->
                        <group string="Attendee">
                            <field name="student_id"
                                   invisible="attendee_type != 'student'"
                                   options="{'no_create': True}"/>
                            <field name="registration_number"
                                   invisible="attendee_type != 'student'"
                                   readonly="1"/>
                            <field name="faculty_id"
                                   invisible="attendee_type != 'faculty'"
                                   options="{'no_create': True}"/>
                            <field name="external_name"
                                   invisible="attendee_type != 'external'"/>
                            <field name="external_org"
                                   invisible="attendee_type != 'external'"/>
                        </group>
                    </group>

                    <group>
                        <!-- ── Academic Classification ──
                             department_id and batch_id are auto-populated
                             from the student record (stored computed).
                             They are shown readonly so staff can see
                             them without being able to accidentally edit them
                             for student attendees.
                        -->
                        <group string="Classification">
                            <field name="department_id"
                                   readonly="attendee_type == 'student'"/>
                            <field name="batch_id"
                                   invisible="attendee_type != 'student'"
                                   readonly="1"/>
                        </group>

                        <!-- ── Attendance Status ── -->
                        <group string="Attendance Status">
                            <field name="status"
                                   widget="badge"
                                   decoration-success="status == 'present'"
                                   decoration-warning="status == 'checked_in'"
                                   decoration-danger="status == 'absent'"/>
                            <field name="marked_at" readonly="1"/>
                            <field name="marked_by" readonly="1"/>
                            <field name="notes"/>
                        </group>
                    </group>

                    <!-- ── QR Check-in / Check-out ── -->
                    <group string="QR Check-in / Check-out Details">
                        <group>
                            <field name="checkin_time" readonly="1"/>
                            <field name="checkin_qr_verified" readonly="1"/>
                        </group>
                        <group>
                            <field name="checkout_time" readonly="1"/>
                            <field name="checkout_qr_verified" readonly="1"/>
                            <field name="duration_minutes"
                                   readonly="1"
                                   string="Duration Stayed (min)"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <!-- ═══════════════════════════════════════════════════════════════════
         LIST VIEW
         Changes:
         - Added batch_id column
         - Added registration_number column
         - Added participant_type column
         - Removed attendee_type (redundant with participant_type)
         - Added duration_minutes
         - Rows colour-coded by status (kept)
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="iic_attendance_view_list" model="ir.ui.view">
        <field name="name">iic.attendance.view.list</field>
        <field name="model">iic.attendance</field>
        <field name="arch" type="xml">
            <list string="IIC Attendance"
                  decoration-success="status == 'present'"
                  decoration-warning="status == 'checked_in'"
                  decoration-muted="status == 'absent'">
                <field name="event_id"/>
                <field name="participant_type" string="Type"/>
                <field name="name" string="Attendee"/>
                <field name="registration_number" string="Reg. No."
                       optional="show"/>
                <field name="department_id" optional="show"/>
                <field name="batch_id" optional="show"/>
                <field name="checkin_time" string="Check-in"
                       optional="show"/>
                <field name="checkout_time" string="Check-out"
                       optional="show"/>
                <field name="duration_minutes" string="Stayed (min)"
                       optional="show"/>
                <field name="checkin_qr_verified" string="QR ✓"
                       widget="boolean_toggle" readonly="1"
                       optional="show"/>
                <field name="status"
                       widget="badge"
                       decoration-success="status == 'present'"
                       decoration-warning="status == 'checked_in'"
                       decoration-danger="status == 'absent'"/>
            </list>
        </field>
    </record>


    <!-- ═══════════════════════════════════════════════════════════════════
         SEARCH VIEW
         Changes:
         - Added batch_id search field
         - Added registration_number search field
         - Added participant_type filter
         - Added "Batch" group-by
         - Added "Academic Year" group-by (via event_id.academic_year_id)
         - Added "Quarter" group-by (via event_id.quarter)
         - Separated student-only and faculty-only filters
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="iic_attendance_view_search" model="ir.ui.view">
        <field name="name">iic.attendance.view.search</field>
        <field name="model">iic.attendance</field>
        <field name="arch" type="xml">
            <search string="Search Attendance">
                <!-- Search fields -->
                <field name="name" string="Attendee Name"/>
                <field name="event_id"/>
                <field name="student_id"/>
                <field name="faculty_id"/>
                <field name="department_id"/>
                <field name="batch_id"/>
                <field name="registration_number" string="Reg. No."/>
                <field name="academic_year_id"/>
                <field name="quarter"/>

                <separator/>

                <!-- Status filters -->
                <filter string="Present"
                        name="present"
                        domain="[('status', '=', 'present')]"/>
                <filter string="Checked In (Pending)"
                        name="checked_in"
                        domain="[('status', '=', 'checked_in')]"/>
                <filter string="Absent"
                        name="absent"
                        domain="[('status', '=', 'absent')]"/>

                <separator/>

                <!-- Participant type filters -->
                <filter string="Students Only"
                        name="students_only"
                        domain="[('participant_type', '=', 'student')]"/>
                <filter string="Faculty Only"
                        name="faculty_only"
                        domain="[('participant_type', '=', 'faculty')]"/>
                <filter string="External"
                        name="external_only"
                        domain="[('participant_type', '=', 'external')]"/>

                <separator/>

                <!-- QR verification filter -->
                <filter string="QR Check-in Verified"
                        name="qr_checkin"
                        domain="[('checkin_qr_verified', '=', True)]"/>
                <filter string="QR Check-out Verified"
                        name="qr_checkout"
                        domain="[('checkout_qr_verified', '=', True)]"/>

                <!-- Group By -->
                <group expand="0" string="Group By">
                    <filter string="Event"
                            name="group_event"
                            context="{'group_by': 'event_id'}"/>
                    <filter string="Department"
                            name="group_dept"
                            context="{'group_by': 'department_id'}"/>
                    <filter string="Batch"
                            name="group_batch"
                            context="{'group_by': 'batch_id'}"/>
                    <filter string="Status"
                            name="group_status"
                            context="{'group_by': 'status'}"/>
                    <filter string="Attendee Type"
                            name="group_type"
                            context="{'group_by': 'participant_type'}"/>
                    <filter string="Quarter"
                            name="group_quarter"
                            context="{'group_by': 'quarter'}"/>
                    <filter string="Academic Year"
                            name="group_academic_year"
                            context="{'group_by': 'academic_year_id'}"/>
                </group>
            </search>
        </field>
    </record>


    <!-- ═══════════════════════════════════════════════════════════════════
         GRAPH VIEW
         Changes:
         - Primary axis: department_id (was event_id — too granular)
         - Secondary axis: status (kept — present vs absent split)
         - Added a second graph view grouped by batch for easy switching
         Original only had event × status which produced too many bars
         when there are many events and told you nothing about who attended.
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="iic_attendance_view_graph" model="ir.ui.view">
        <field name="name">iic.attendance.view.graph</field>
        <field name="model">iic.attendance</field>
        <field name="arch" type="xml">
            <graph string="Attendance by Department" type="bar">
                <field name="department_id" type="row"/>
                <field name="status" type="col"/>
            </graph>
        </field>
    </record>

    <!-- Batch-wise graph (secondary, selectable via More Views) -->
    <record id="iic_attendance_view_graph_batch" model="ir.ui.view">
        <field name="name">iic.attendance.view.graph.batch</field>
        <field name="model">iic.attendance</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <graph string="Attendance by Batch" type="bar">
                <field name="batch_id" type="row"/>
                <field name="status" type="col"/>
            </graph>
        </field>
    </record>

    <!-- Event-wise graph (tertiary) -->
    <record id="iic_attendance_view_graph_event" model="ir.ui.view">
        <field name="name">iic.attendance.view.graph.event</field>
        <field name="model">iic.attendance</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <graph string="Attendance by Event" type="bar">
                <field name="event_id" type="row"/>
                <field name="status" type="col"/>
            </graph>
        </field>
    </record>


    <!-- ═══════════════════════════════════════════════════════════════════
         PIVOT VIEW
         Changes:
         - Rows: event_id (kept — event is the natural unit of analysis)
         - Columns: department_id AND batch_id as separate pivot dimensions
         - Measure: count of records (implicit), split by status column
         Original had event × department × status which is correct in
         concept but didn't include batch at all.
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="iic_attendance_view_pivot" model="ir.ui.view">
        <field name="name">iic.attendance.view.pivot</field>
        <field name="model">iic.attendance</field>
        <field name="arch" type="xml">
            <pivot string="Attendance Analysis"
                   disable_linking="0">
                <!-- Rows: event then department for drill-down -->
                <field name="event_id" type="row"/>
                <field name="department_id" type="row"/>
                <!-- Columns: present/absent/checked_in split -->
                <field name="status" type="col"/>
                <!-- Measures available in the pivot measure menu -->
                <field name="duration_minutes" type="measure" string="Avg Duration (min)"/>
            </pivot>
        </field>
    </record>

    <!-- Batch pivot (alternative analysis) -->
    <record id="iic_attendance_view_pivot_batch" model="ir.ui.view">
        <field name="name">iic.attendance.view.pivot.batch</field>
        <field name="model">iic.attendance</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <pivot string="Attendance by Batch">
                <field name="batch_id" type="row"/>
                <field name="event_id" type="row"/>
                <field name="status" type="col"/>
                <field name="duration_minutes" type="measure" string="Avg Duration (min)"/>
            </pivot>
        </field>
    </record>


    <!-- ═══════════════════════════════════════════════════════════════════
         WINDOW ACTION
         Changes:
         - view_mode now includes all 5 view types: list, graph, pivot, form
         - Default group_by set to event_id so the list opens grouped
         - context passes participant_type = student by default (most common)
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="action_iic_attendance" model="ir.actions.act_window">
        <field name="name">IIC Attendance</field>
        <field name="res_model">iic.attendance</field>
        <field name="view_mode">list,graph,pivot,form</field>
        <field name="search_view_id" ref="iic_attendance_view_search"/>
        <field name="context">{
            'search_default_group_event': 1,
            'search_default_students_only': 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No attendance records found.
            </p>
            <p>
                Attendance is captured automatically via QR code check-in/check-out
                during IIC events. Use the Bulk Attendance wizard on an event to
                add records manually.
            </p>
        </field>
    </record>

</odoo>