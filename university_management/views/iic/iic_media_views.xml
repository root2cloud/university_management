<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="iic_media_view_form" model="ir.ui.view">
        <field name="name">iic.media.view.form</field>
        <field name="model">iic.media</field>
        <field name="arch" type="xml">
            <form string="Event Media">
                <sheet>
                    <group>
                        <group>
                            <field name="event_id" options="{'no_create': True}"/>
                            <field name="name" placeholder="Caption or Title"/>
                            <field name="media_type"/>
                        </group>
                        <group>
                            <field name="upload_date"/>
                            <field name="uploaded_by"/>
                        </group>
                    </group>
                    <group invisible="media_type != 'photo'">
                        <field name="image" widget="image" nolabel="1"
                               options="{'size': [500, 300]}"/>
                    </group>
                    <group invisible="media_type != 'video'">
                        <field name="video_url" placeholder="https://..."/>
                    </group>
                    <group invisible="media_type not in ['document']">
                        <field name="attachment" widget="binary" nolabel="1"/>
                        <field name="filename"/>
                    </group>
                    <notebook>
                        <page string="Photo Gallery" invisible="media_type != 'photo'">
                            <field name="image_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="image" widget="image" options="{'size': [80, 80]}"/>
                                    <field name="name" placeholder="Caption (optional)"/>
                                    <field name="filename"/>
                                    <field name="is_cover"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="summary" placeholder="Event summary..."/>
                            <field name="key_takeaways" placeholder="Key takeaways..."/>
                            <field name="student_insights" placeholder="Student participation insights..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="iic_media_view_list" model="ir.ui.view">
        <field name="name">iic.media.view.list</field>
        <field name="model">iic.media</field>
        <field name="arch" type="xml">
            <list string="Event Media">
                <field name="event_id"/>
                <field name="name"/>
                <field name="media_type"/>
                <field name="upload_date"/>
                <field name="uploaded_by"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="iic_media_view_kanban" model="ir.ui.view">
        <field name="name">iic.media.view.kanban</field>
        <field name="model">iic.media</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="attachment"/>
                <field name="media_type"/>
                <field name="event_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_image" invisible="media_type != 'photo'">
                                <img t-att-src="kanban_image('iic.media', 'attachment', record.id.raw_value)"
                                     alt="Media" class="o_image_64_cover"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                                <div class="text-muted"><field name="event_id"/></div>
                                <span class="badge badge-pill badge-info"><field name="media_type"/></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="action_iic_media" model="ir.actions.act_window">
        <field name="name">Event Media</field>
        <field name="res_model">iic.media</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

</odoo>