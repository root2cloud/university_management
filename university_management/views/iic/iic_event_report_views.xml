<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="iic_event_report_view_form" model="ir.ui.view">
        <field name="name">iic.event.report.view.form</field>
        <field name="model">iic.event.report</field>
        <field name="arch" type="xml">
            <form string="IIC Event Report">
                <header>
                    <button name="action_submit" string="Submit for Approval" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve Report" type="object"
                            class="btn-success" invisible="state != 'submitted'"
                            groups="university_management.group_university_admin"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state != 'submitted'"
                            groups="university_management.group_university_admin"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state not in ['submitted', 'rejected']"/>
                    <button name="action_print_pdf" string="Export PDF" type="object"
                            class="btn-secondary" invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Event Info">
                            <field name="event_id" options="{'no_create': True}"/>
                            <field name="event_title"/>
                            <field name="event_date"/>
                            <field name="venue"/>
                            <field name="activity_type"/>
                        </group>
                        <group string="People">
                            <field name="speaker_id"/>
                            <field name="faculty_incharge_id"/>
                            <field name="attendance_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Event Description" name="description">
                            <field name="event_description" nolabel="1"/>
                        </page>
                        <page string="Objectives &amp; Outcomes" name="outcomes">
                            <group>
                                <field name="objectives" placeholder="Objectives of the event..."/>
                                <field name="outcomes" placeholder="Outcomes and achievements..."/>
                                <field name="student_feedback" placeholder="Student feedback summary..."/>
                            </group>
                        </page>
                        <page string="Detailed Report" name="detailed_report">
                            <field name="report_summary" nolabel="1"/>
                        </page>
                        <page string="Photos" name="photos">
                            <field name="photo_ids" widget="many2many_kanban"
                                   options="{'quick_create': False}">
                                <kanban>
                                    <field name="name"/>
                                    <field name="attachment"/>
                                    <templates>
                                        <t t-name="kanban-box">
                                            <div class="oe_kanban_card">
                                                <img t-att-src="kanban_image('iic.media', 'attachment', record.id.raw_value)"
                                                     alt="Photo" style="max-width:150px;"/>
                                                <div><field name="name"/></div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="iic_event_report_view_list" model="ir.ui.view">
        <field name="name">iic.event.report.view.list</field>
        <field name="model">iic.event.report</field>
        <field name="arch" type="xml">
            <list string="IIC Event Reports" decoration-success="state == 'approved'"
                  decoration-warning="state == 'submitted'">
                <field name="name"/>
                <field name="event_id"/>
                <field name="event_date"/>
                <field name="activity_type"/>
                <field name="attendance_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-warning="state == 'submitted'"/>
                <field name="approved_by"/>
                <field name="approved_date"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="iic_event_report_view_search" model="ir.ui.view">
        <field name="name">iic.event.report.view.search</field>
        <field name="model">iic.event.report</field>
        <field name="arch" type="xml">
            <search string="Search Reports">
                <field name="event_id"/>
                <field name="event_title"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Pending Approval" name="pending" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <group expand="0" string="Group By">
                    <filter string="Activity Type" name="group_type" context="{'group_by': 'activity_type'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_iic_event_report" model="ir.actions.act_window">
        <field name="name">IIC Event Reports</field>
        <field name="res_model">iic.event.report</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="iic_event_report_view_search"/>
    </record>

</odoo>
