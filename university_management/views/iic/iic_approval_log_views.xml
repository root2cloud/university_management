<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="iic_approval_log_view_list" model="ir.ui.view">
        <field name="name">iic.approval.log.view.list</field>
        <field name="model">iic.approval.log</field>
        <field name="arch" type="xml">
            <list string="IIC Approval Logs" create="0" delete="0">
                <field name="timestamp"/>
                <field name="event_id"/>
                <field name="action"/>
                <field name="user_id"/>
                <field name="remarks"/>
            </list>
        </field>
    </record>

    <record id="iic_approval_log_view_search" model="ir.ui.view">
        <field name="name">iic.approval.log.view.search</field>
        <field name="model">iic.approval.log</field>
        <field name="arch" type="xml">
            <search string="Search Logs">
                <field name="event_id"/>
                <field name="user_id"/>
                <field name="action"/>
                <group expand="0" string="Group By">
                    <filter string="Event" name="group_event" context="{'group_by': 'event_id'}"/>
                    <filter string="User" name="group_user" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_iic_approval_log" model="ir.actions.act_window">
        <field name="name">Approval Logs</field>
        <field name="res_model">iic.approval.log</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="iic_approval_log_view_search"/>
    </record>

</odoo>
