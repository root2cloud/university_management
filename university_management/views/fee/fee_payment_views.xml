<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="fee_payment_view_form" model="ir.ui.view">
        <field name="name">fee.payment.view.form</field>
        <field name="model">fee.payment</field>
        <field name="arch" type="xml">
            <form string="Fee Payment">
                <header>
                    <button name="action_submit"
                            string="Submit for Verification"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>

                    <button name="action_verify"
                            string="Verify Payment"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'pending'"
                            groups="base.group_user"/>

                    <button name="action_confirm_payment"
                            string="Confirm &amp; Send Invoice"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'verified'"
                            confirm="This will create the invoice and send it to the student for portal payment. Continue?"/>

                    <button name="action_print_receipt"
                            string="Print Receipt"
                            type="object"
                            invisible="state not in ['paid', 'refunded']"
                            class="btn-primary"/>

                    <button name="action_refund"
                            string="Process Refund"
                            type="object"
                            invisible="state != 'paid'"
                            groups="base.group_user"
                            confirm="Process refund for this payment?"/>

                    <button name="action_cancel"
                            string="Cancel Payment"
                            type="object"
                            invisible="state in ['paid', 'cancelled', 'refunded']"
                            confirm="Cancel this payment?"/>

                    <button name="action_reset_to_draft"
                            type="object"
                            string="Reset to Draft"
                            invisible="state == 'draft'"
                            confirm="Are you sure you want to reset this Payment to draft?"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending,verified,invoiced,partial,paid"/>
                </header>

                <sheet>
                    <widget name="web_ribbon" title="Paid"
                            bg_color="text-bg-success"
                            invisible="state != 'paid'"/>
                    <widget name="web_ribbon" title="Partially Paid"
                            bg_color="text-bg-warning"
                            invisible="state != 'partial'"/>
                    <widget name="web_ribbon" title="Invoice Sent"
                            bg_color="text-bg-info"
                            invisible="state != 'invoiced'"/>
                    <widget name="web_ribbon" title="Refunded"
                            bg_color="text-bg-warning"
                            invisible="state != 'refunded'"/>
                    <widget name="web_ribbon" title="Cancelled"
                            bg_color="text-bg-secondary"
                            invisible="state != 'cancelled'"/>

                    <div class="oe_title">
                        <label for="student_id" string="Student"/>
                        <h1>
                            <field name="student_id"
                                   placeholder="Select Student"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                        </h1>
                        <h2>
                            <field name="name" readonly="1"/>
                        </h2>
                    </div>

                    <group>
                        <group string="Student Information">
                            <field name="registration_number" readonly="1"/>
                            <field name="student_temp_id" readonly="1"
                                   string="Temp Student ID"
                                   invisible="student_usn_mapped"/>
                            <field name="student_usn" readonly="1"
                                   string="University USN"
                                   invisible="not student_usn_mapped"/>
                            <field name="student_usn_mapped" invisible="1"/>
                            <field name="program_id" readonly="1"/>
                            <field name="department_id" readonly="1"/>
                        </group>
                        <group string="Fee Structure">
                            <field name="fee_structure_id"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="academic_year_id" readonly="1"/>
                            <field name="semester_id" readonly="1"/>
                            <field name="payment_term" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <group string="Payment Details">
                            <field name="payment_date" readonly="1"/>
                            <field name="due_date" widget="date"/>
                            <field name="payment_method" readonly="1"/>
                        </group>
                        <group string="References">
                            <field name="discount_id"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="scholarship_id"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                    </group>

                    <group string="Amount Breakdown">
                        <group>
                            <field name="amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="late_fee" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="discount_amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                        </group>
                        <group>
                            <field name="total_amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1"
                                   class="oe_subtotal_footer_separator"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <!-- Portal Payment Progress -->
                    <group string="Portal Payment Progress"
                           invisible="state not in ['invoiced', 'partial', 'paid']">
                        <group>
                            <field name="amount_paid" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1"/>
                            <field name="outstanding_amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Accounting" name="accounting">
                            <group>
                                <group>
                                    <field name="journal_id" widget="many2one"/>
                                    <field name="account_payment_id" widget="many2one" readonly="1"/>
                                    <field name="payment_state" widget="badge"
                                           decoration-success="payment_state == 'paid'"
                                           decoration-warning="payment_state in ['partial', 'in_payment']"
                                           decoration-danger="payment_state == 'not_paid'"/>
                                </group>
                                <group>
                                    <field name="account_move_id" widget="many2one" readonly="1"/>
                                    <field name="reconciliation_status" widget="badge"
                                           decoration-success="reconciliation_status == 'fully_reconciled'"
                                           decoration-warning="reconciliation_status == 'partially_reconciled'"
                                           decoration-danger="reconciliation_status == 'not_reconciled'"/>
                                </group>
                            </group>
                            <div class="alert alert-info" role="alert"
                                 invisible="state not in ['invoiced', 'partial'] or payment_state == 'paid'">
                                <i class="fa fa-info-circle"/> Invoice has been sent to the student.
                                The <strong>Accounting Payment</strong> and
                                <strong>Reconciliation Status</strong> will update automatically
                                once the student pays via the portal.
                            </div>
                        </page>

                        <page string="Journal Items" name="journal_items">
                            <group>
                                <field name="account_move_line_ids" widget="One2many"/>
                            </group>
                        </page>

                        <page string="Payment Information" name="payment_info">
                            <group>
                                <group string="Payment Reference">
                                    <field name="payment_reference"/>
                                    <field name="bank_name"/>
                                    <field name="cheque_number"/>
                                    <field name="cheque_date"/>
                                </group>
                                <group string="Collection Details">
                                    <field name="collected_by"/>
                                    <field name="receipt_printed" widget="boolean"/>
                                    <field name="receipt_sent" widget="boolean"/>
                                </group>
                            </group>
                        </page>

                        <page string="Verification" name="verification">
                            <group>
                                <group>
                                    <field name="verified_by" readonly="1"/>
                                    <field name="verification_date" widget="date" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Invoice" name="invoice">
                            <group>
                                <group>
                                    <field name="invoice_id" readonly="1"/>
                                    <field name="invoice_status" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Refund Details" name="refund"
                              invisible="state != 'refunded'">
                            <group>
                                <group>
                                    <field name="refund_date" widget="date" readonly="1"/>
                                    <field name="refund_amount" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="refund_move_id" widget="Many2one"/>
                                </group>
                            </group>
                            <separator string="Refund Reason"/>
                            <field name="refund_reason"
                                   placeholder="Enter reason for refund..."/>
                        </page>

                        <page string="Notes" name="notes">
                            <field name="notes"
                                   placeholder="Enter any additional notes about this payment..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="fee_payment_view_list" model="ir.ui.view">
        <field name="name">fee.payment.view.list</field>
        <field name="model">fee.payment</field>
        <field name="arch" type="xml">
            <list string="Fee Payments"
                  default_order="payment_date desc"
                  multi_edit="1"
                  sample="1"
                  decoration-success="state == 'paid'"
                  decoration-info="state == 'invoiced'"
                  decoration-warning="state == 'partial'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="student_id"/>
                <field name="registration_number" optional="show"/>
                <field name="program_id" optional="hide"/>
                <field name="department_id" optional="hide"/>
                <field name="fee_structure_id" optional="hide"/>
                <field name="payment_term" optional="show"/>
                <field name="payment_date"/>
                <field name="due_date" optional="hide"/>
                <field name="payment_method" readonly="1"/>
                <field name="amount" widget="monetary" sum="Total Amount"/>
                <field name="amount_paid" widget="monetary" sum="Total Paid" optional="show"/>
                <field name="outstanding_amount" widget="monetary"
                       sum="Total Outstanding" optional="show"/>
                <field name="late_fee" widget="monetary" sum="Total Late Fee" optional="hide"/>
                <field name="discount_amount" widget="monetary"
                       sum="Total Discount" optional="hide"/>
                <field name="total_amount" widget="monetary" sum="Grand Total"/>
                <field name="payment_reference" optional="hide"/>
                <field name="collected_by" optional="hide"/>
                <field name="verified_by" optional="hide"/>
                <field name="receipt_printed" widget="boolean_toggle" optional="hide"/>
                <field name="receipt_sent" widget="boolean_toggle" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-warning="state in ['pending', 'verified', 'partial']"
                       decoration-info="state == 'invoiced'"
                       decoration-success="state == 'paid'"
                       decoration-danger="state == 'refunded'"/>
            </list>
        </field>
    </record>

    <!-- ================================================================ -->
    <!--  SEARCH VIEW                                                       -->
    <!--  Changes vs original:                                             -->
    <!--   1. Added payment_date as a searchable field                     -->
    <!--   2. Added quick date-range filters (This Week / Last 30 Days /   -->
    <!--      Last 3 Months / This Year)                                   -->
    <!--   3. Added Payment Month group-by                                 -->
    <!-- ================================================================ -->
    <record id="fee_payment_view_search" model="ir.ui.view">
        <field name="name">fee.payment.view.search</field>
        <field name="model">fee.payment</field>
        <field name="arch" type="xml">
            <search string="Search Fee Payments">

                <!-- Text / relational search fields -->
                <field name="name"/>
                <field name="student_id"/>
                <field name="registration_number"/>
                <field name="payment_reference"/>
                <field name="fee_structure_id"/>
                <field name="payment_term"/>

                <!--
                    DATE RANGE SEARCH
                    Exposes payment_date in the search bar so the user can
                    type a date and choose operators (is, is before, is after,
                    is between) directly from the search dropdown — the
                    simplest way to filter any custom date range without a
                    wizard.  The wizard (fee.date.range.wizard) provides a
                    richer popup alternative with a live summary preview.
                -->
                <field name="payment_date" string="Payment Date"/>

                <separator/>

                <!-- ── Status filters ───────────────────────────────── -->
                <filter name="filter_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_pending" string="Pending Verification"
                        domain="[('state', '=', 'pending')]"/>
                <filter name="filter_verified" string="Verified"
                        domain="[('state', '=', 'verified')]"/>
                <filter name="filter_invoiced" string="Invoice Sent"
                        domain="[('state', '=', 'invoiced')]"/>
                <filter name="filter_partial" string="Partially Paid"
                        domain="[('state', '=', 'partial')]"/>
                <filter name="filter_paid" string="Paid"
                        domain="[('state', '=', 'paid')]"/>
                <filter name="filter_refunded" string="Refunded"
                        domain="[('state', '=', 'refunded')]"/>
                <filter name="filter_cancelled" string="Cancelled"
                        domain="[('state', '=', 'cancelled')]"/>

                <separator/>

                <!-- ── Smart filters ────────────────────────────────── -->
                <filter name="filter_awaiting_payment" string="Awaiting Payment"
                        domain="[('state', 'in', ['invoiced', 'partial'])]"/>
                <filter name="filter_has_outstanding" string="Has Outstanding Balance"
                        domain="[('outstanding_amount', '>', 0)]"/>
                <filter name="filter_receipt_not_printed" string="Receipt Not Printed"
                        domain="[('receipt_printed', '=', False), ('state', '=', 'paid')]"/>
                <filter name="filter_receipt_not_sent" string="Receipt Not Sent"
                        domain="[('receipt_sent', '=', False), ('state', '=', 'paid')]"/>

                <separator/>

                <!-- ── Date range quick filters ─────────────────────── -->
                <filter name="filter_today"
                        string="Today"
                        domain="[('payment_date', '=', context_today().strftime('%Y-%m-%d'))]"/>

                <filter name="filter_this_week"
                        string="This Week"
                        domain="[
                            ('payment_date', '&gt;=', (context_today() - relativedelta(weekday=0, weeks=1)).strftime('%Y-%m-%d')),
                            ('payment_date', '&lt;=', context_today().strftime('%Y-%m-%d'))
                        ]"/>

                <filter name="filter_this_month"
                        string="This Month"
                        domain="[
                            ('payment_date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d')),
                            ('payment_date', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))
                        ]"/>

                <filter name="filter_last_30_days"
                        string="Last 30 Days"
                        domain="[
                            ('payment_date', '&gt;=', (context_today() - relativedelta(days=30)).strftime('%Y-%m-%d')),
                            ('payment_date', '&lt;=', context_today().strftime('%Y-%m-%d'))
                        ]"/>

                <filter name="filter_last_3_months"
                        string="Last 3 Months"
                        domain="[
                            ('payment_date', '&gt;=', (context_today() - relativedelta(months=3)).strftime('%Y-%m-%d')),
                            ('payment_date', '&lt;=', context_today().strftime('%Y-%m-%d'))
                        ]"/>

                <filter name="filter_this_year"
                        string="This Year"
                        domain="[
                            ('payment_date', '&gt;=', context_today().strftime('%Y-01-01')),
                            ('payment_date', '&lt;=', context_today().strftime('%Y-12-31'))
                        ]"/>

                <!-- ── Group By ──────────────────────────────────────── -->
                <group expand="0" string="Group By">
                    <filter name="group_by_student" string="Student"
                            context="{'group_by': 'student_id'}"/>
                    <filter name="group_by_program" string="Program"
                            context="{'group_by': 'program_id'}"/>
                    <filter name="group_by_department" string="Department"
                            context="{'group_by': 'department_id'}"/>
                    <filter name="group_by_fee_structure" string="Fee Structure"
                            context="{'group_by': 'fee_structure_id'}"/>
                    <filter name="group_by_payment_term" string="Payment Term"
                            context="{'group_by': 'payment_term'}"/>
                    <filter name="group_by_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_by_payment_date" string="Payment Date"
                            context="{'group_by': 'payment_date'}"/>
                    <filter name="group_by_payment_date_month" string="Payment Month"
                            context="{'group_by': 'payment_date:month'}"/>
                </group>

                <searchpanel>
                    <field name="academic_year_id" string="Academic Year"
                           select="multi" icon="fa-calendar"/>
                    <field name="semester_id" string="Semester"
                           select="multi" icon="fa-graduation-cap"/>
                    <field name="state" string="Status"
                           select="multi" icon="fa-filter"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="fee_payment_view_kanban" model="ir.ui.view">
        <field name="name">fee.payment.view.kanban</field>
        <field name="model">fee.payment</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile"
                    default_group_by="state"
                    quick_create="false"
                    sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="student_id"/>
                <field name="payment_date"/>
                <field name="payment_method"/>
                <field name="payment_term"/>
                <field name="total_amount"/>
                <field name="amount_paid"/>
                <field name="outstanding_amount"/>
                <field name="state"/>
                <field name="receipt_printed"/>
                <field name="receipt_sent"/>

                <progressbar field="state"
                             colors='{"draft": "muted", "pending": "warning", "verified": "info", "invoiced": "info", "partial": "warning", "paid": "success"}'/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="student_id"/>
                                        </strong>
                                        <div class="text-muted">
                                            <field name="name"/>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_top_right">
                                        <field name="state" widget="badge"
                                               decoration-muted="state == 'draft'"
                                               decoration-warning="state in ['pending', 'verified', 'partial']"
                                               decoration-info="state == 'invoiced'"
                                               decoration-success="state == 'paid'"
                                               decoration-danger="state == 'refunded'"/>
                                    </div>
                                </div>

                                <div class="o_kanban_record_body">
                                    <div class="row mb-2">
                                        <div class="col-6">
                                            <i class="fa fa-calendar text-primary"/>
                                            <field name="payment_date"/>
                                        </div>
                                        <div class="col-6">
                                            <i class="fa fa-money text-warning"/>
                                            <strong>₹ <field name="total_amount"/></strong>
                                        </div>
                                    </div>
                                    <div class="row mb-2"
                                         t-if="record.state.raw_value in ['invoiced', 'partial']">
                                        <div class="col-6">
                                            <small class="text-success">
                                                Paid: ₹ <field name="amount_paid"/>
                                            </small>
                                        </div>
                                        <div class="col-6">
                                            <small class="text-danger">
                                                Due: ₹ <field name="outstanding_amount"/>
                                            </small>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-6">
                                            <span t-if="record.receipt_printed.raw_value"
                                                  class="badge text-bg-success">
                                                <i class="fa fa-print"/> Printed
                                            </span>
                                        </div>
                                        <div class="col-6">
                                            <span t-if="record.receipt_sent.raw_value"
                                                  class="badge text-bg-info">
                                                <i class="fa fa-envelope"/> Sent
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_right">
                                        <field name="activity_ids" widget="kanban_activity"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Calendar View -->
    <record id="fee_payment_view_calendar" model="ir.ui.view">
        <field name="name">fee.payment.view.calendar</field>
        <field name="model">fee.payment</field>
        <field name="arch" type="xml">
            <calendar string="Payment Calendar"
                      date_start="payment_date"
                      color="state"
                      mode="month"
                      event_open_popup="true"
                      quick_create="false">
                <field name="student_id"/>
                <field name="name"/>
                <field name="total_amount"/>
                <field name="outstanding_amount"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="fee_payment_view_pivot" model="ir.ui.view">
        <field name="name">fee.payment.view.pivot</field>
        <field name="model">fee.payment</field>
        <field name="arch" type="xml">
            <pivot string="Payment Analysis">
                <field name="payment_term" type="col"/>
                <field name="program_id" type="row"/>
                <field name="total_amount" type="measure"/>
                <field name="amount_paid" type="measure"/>
                <field name="outstanding_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="fee_payment_view_graph" model="ir.ui.view">
        <field name="name">fee.payment.view.graph</field>
        <field name="model">fee.payment</field>
        <field name="arch" type="xml">
            <graph string="Payment Statistics" type="bar">
                <field name="payment_date" interval="month"/>
                <field name="total_amount" type="measure"/>
                <field name="amount_paid" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Main Fee Payments Action -->
    <record id="action_fee_payment" model="ir.actions.act_window">
        <field name="name">Fee Payments</field>
        <field name="res_model">fee.payment</field>
        <field name="view_mode">kanban,list,form,calendar,pivot,graph</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record a new Fee Payment
            </p>
            <p>
                Manage student fee payments with portal payment support,
                partial payment tracking, automatic state sync,
                receipt printing, and email notifications.
            </p>
        </field>
    </record>

    <!-- ================================================================ -->
    <!--  DATE RANGE FILTER WIZARD ACTION                                  -->
    <!--  Accessible from:                                                 -->
    <!--    - Fee menu (add as menu item pointing to this action)          -->
    <!--    - University dashboard Fee section button                      -->
    <!--  Opens fee.date.range.wizard as a popup dialog.                  -->
    <!-- ================================================================ -->
    <record id="action_fee_date_range_wizard" model="ir.actions.act_window">
        <field name="name">Filter by Date Range</field>
        <field name="res_model">fee.date.range.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>