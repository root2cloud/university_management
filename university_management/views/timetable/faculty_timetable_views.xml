<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View - Faculty Timetable -->
    <record id="faculty_timetable_view_list" model="ir.ui.view">
        <field name="name">faculty.timetable.view.list</field>
        <field name="model">faculty.timetable</field>
        <field name="arch" type="xml">
            <list string="Faculty Timetable"
                  create="false"
                  edit="false"
                  delete="false"
                  default_order="faculty_id, day_of_week, start_time"
                  sample="1">
                <field name="faculty_id"/>
                <field name="day_of_week"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="subject_id"/>
                <field name="batch_id"/>
                <field name="room_number_id" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Search View - Faculty Timetable -->
    <record id="faculty_timetable_view_search" model="ir.ui.view">
        <field name="name">faculty.timetable.view.search</field>
        <field name="model">faculty.timetable</field>
        <field name="arch" type="xml">
            <search string="Search Faculty Timetable">
                <field name="faculty_id"/>
                <field name="subject_id"/>
                <field name="batch_id"/>
                <field name="room_number_id"/>

                <separator/>

                <filter name="filter_monday" string="Monday"
                        domain="[('day_of_week', '=', '0')]"/>
                <filter name="filter_tuesday" string="Tuesday"
                        domain="[('day_of_week', '=', '1')]"/>
                <filter name="filter_wednesday" string="Wednesday"
                        domain="[('day_of_week', '=', '2')]"/>
                <filter name="filter_thursday" string="Thursday"
                        domain="[('day_of_week', '=', '3')]"/>
                <filter name="filter_friday" string="Friday"
                        domain="[('day_of_week', '=', '4')]"/>
                <filter name="filter_saturday" string="Saturday"
                        domain="[('day_of_week', '=', '5')]"/>
                <filter name="filter_sunday" string="Sunday"
                        domain="[('day_of_week', '=', '6')]"/>

                <group expand="0" string="Group By">
                    <filter name="group_by_faculty" string="Faculty"
                            context="{'group_by': 'faculty_id'}"/>
                    <filter name="group_by_day" string="Day"
                            context="{'group_by': 'day_of_week'}"/>
                    <filter name="group_by_subject" string="Subject"
                            context="{'group_by': 'subject_id'}"/>
                    <filter name="group_by_batch" string="Batch"
                            context="{'group_by': 'batch_id'}"/>
                </group>

                <searchpanel>
                    <field name="faculty_id" string="Faculty"
                           icon="fa-user"
                           hierarchize="0"/>
                    <field name="day_of_week" string="Day"
                           select="multi"
                           icon="fa-calendar-o"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Kanban View - Faculty Timetable -->
    <record id="faculty_timetable_view_kanban" model="ir.ui.view">
        <field name="name">faculty.timetable.view.kanban</field>
        <field name="model">faculty.timetable</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile"
                    default_group_by="faculty_id"
                    create="false"
                    edit="false"
                    delete="false"
                    quick_create="false"
                    sample="1">
                <field name="id"/>
                <field name="faculty_id"/>
                <field name="day_of_week"/>
                <field name="start_time"/>
                <field name="end_time"/>
                <field name="subject_id"/>
                <field name="batch_id"/>
                <field name="room_number_id"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="subject_id"/>
                                        </strong>
                                        <div class="text-muted mt-1">
                                            <small>
                                                <span class="badge bg-primary">
                                                    <field name="day_of_week"/>
                                                </span>
                                            </small>
                                        </div>
                                    </div>
                                </div>

                                <div class="o_kanban_record_body mt-3">
                                    <div class="row mb-2">
                                        <div class="col-12">
                                            <div class="alert alert-info mb-0 p-2 text-center">
                                                <h5 class="mb-0">
                                                    <i class="fa fa-clock-o" title="Time"/>
                                                    <field name="start_time" widget="float_time"/> -
                                                    <field name="end_time" widget="float_time"/>
                                                </h5>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row mb-2">
                                        <div class="col-12">
                                            <div class="bg-light p-2 rounded">
                                                <small class="text-muted d-block">Batch</small>
                                                <small>
                                                    <i class="fa fa-users text-success" title="Batch"/>
                                                    <field name="batch_id"/>
                                                </small>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row" t-if="record.room_number_id.raw_value">
                                        <div class="col-12">
                                            <div class="bg-light p-2 rounded">
                                                <small class="text-muted d-block">Room</small>
                                                <small>
                                                    <i class="fa fa-map-marker text-danger" title="Room"/>
                                                    <field name="room_number_id"/>
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Pivot View - Faculty Timetable -->
    <record id="faculty_timetable_view_pivot" model="ir.ui.view">
        <field name="name">faculty.timetable.view.pivot</field>
        <field name="model">faculty.timetable</field>
        <field name="arch" type="xml">
            <pivot string="Faculty Schedule Analysis">
                <field name="faculty_id" type="row"/>
                <field name="day_of_week" type="col"/>
                <field name="duration" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View - Faculty Timetable -->
    <record id="faculty_timetable_view_graph" model="ir.ui.view">
        <field name="name">faculty.timetable.view.graph</field>
        <field name="model">faculty.timetable</field>
        <field name="arch" type="xml">
            <graph string="Faculty Workload Analysis"
                   type="bar"
                   sample="1">
                <field name="faculty_id"/>
                <field name="duration" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Action -->
    <record id="action_faculty_timetable" model="ir.actions.act_window">
        <field name="name">Faculty Timetable</field>
        <field name="res_model">faculty.timetable</field>
        <field name="view_mode">kanban,list,pivot,graph</field>
        <field name="context">{'search_default_group_by_faculty': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Faculty Timetable
            </p>
            <p>
                Read-only teaching schedule per faculty, generated automatically from the
                Timetable entries (university.timetable).
            </p>
        </field>
    </record>

</odoo>