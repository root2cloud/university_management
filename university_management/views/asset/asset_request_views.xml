<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════
         ASSET REQUEST — FORM VIEW
    ══════════════════════════════════════════════════════ -->
    <record id="asset_request_view_form" model="ir.ui.view">
        <field name="name">asset.request.view.form</field>
        <field name="model">asset.request</field>
        <field name="arch" type="xml">
            <form string="Asset Request">
                <header>
                    <button name="action_submit" string="Submit Request" type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_review" string="Take Under Review" type="object"
                            class="btn-secondary"
                            invisible="state != 'submitted'"
                            groups="university_management.group_university_admin,university_management.group_hod"/>
                    <button name="action_approve" string="Approve" type="object"
                            class="btn-primary"
                            invisible="state not in ('submitted','in_review')"
                            groups="university_management.group_university_admin,university_management.group_hod"/>
                    <button name="action_reject" string="Reject" type="object"
                            class="btn-danger"
                            invisible="state in ('draft','fulfilled','rejected')"
                            groups="university_management.group_university_admin,university_management.group_hod"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state not in ('rejected')"
                            groups="university_management.group_university_admin"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,in_review,approved,pending_purchase,fulfilled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_helpdesk_ticket" type="object"
                                class="oe_stat_button" icon="fa-ticket"
                                invisible="not helpdesk_ticket_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Helpdesk</span>
                                <span class="o_stat_text">Ticket</span>
                            </div>
                        </button>
                        <button name="action_view_purchase_order" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="not purchase_order_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Purchase</span>
                                <span class="o_stat_text">Order</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group string="Request Details">
                            <field name="requester_id"/>
                            <field name="department_id"/>
                            <field name="request_date"/>
                            <field name="required_date"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group string="Asset Required">
                            <field name="asset_category_id"/>
                            <field name="asset_id"
                                   domain="[('category_id','=',asset_category_id),('state','=','active')]"/>
                            <field name="quantity"/>
                            <field name="estimated_cost"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <group string="Purpose / Justification">
                        <field name="description" nolabel="1"
                               placeholder="Describe what this asset will be used for and why it is needed..."/>
                    </group>

                    <!-- Availability & Resolution -->
                    <group string="Availability &amp; Resolution"
                           invisible="state == 'draft'">
                        <group>
                            <field name="availability_status" readonly="1"
                                   widget="badge"
                                   decoration-success="availability_status == 'available'"
                                   decoration-danger="availability_status == 'not_available'"
                                   decoration-warning="availability_status == 'unknown'"/>
                            <field name="assigned_asset_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="approved_by" readonly="1"/>
                            <field name="approval_date" readonly="1"/>
                            <field name="fulfilled_date" readonly="1"/>
                        </group>
                    </group>

                    <!-- Rejection reason -->
                    <group string="Rejection" invisible="state != 'rejected'">
                        <field name="rejection_reason" nolabel="1"/>
                    </group>

                    <!-- Vendor suggestion -->
                    <group string="Purchase Details"
                           invisible="availability_status != 'not_available'">
                        <field name="vendor_id"/>
                    </group>

                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Internal notes..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════
         ASSET REQUEST — LIST VIEW
    ══════════════════════════════════════════════════════ -->
    <record id="asset_request_view_list" model="ir.ui.view">
        <field name="name">asset.request.view.list</field>
        <field name="model">asset.request</field>
        <field name="arch" type="xml">
            <list string="Asset Requests" decoration-success="state=='fulfilled'"
                  decoration-danger="state=='rejected'"
                  decoration-warning="state=='pending_purchase'"
                  decoration-info="state in ('submitted','in_review')">
                <field name="name"/>
                <field name="request_date"/>
                <field name="requester_id"/>
                <field name="department_id"/>
                <field name="asset_category_id"/>
                <field name="quantity"/>
                <field name="required_date"/>
                <field name="priority" widget="priority"/>
                <field name="availability_status" widget="badge"
                       decoration-success="availability_status == 'available'"
                       decoration-danger="availability_status == 'not_available'"/>
                <field name="helpdesk_ticket_id" optional="show"/>
                <field name="purchase_order_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'fulfilled'"
                       decoration-danger="state == 'rejected'"
                       decoration-warning="state == 'pending_purchase'"
                       decoration-info="state in ('submitted','in_review','approved')"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════
         ASSET REQUEST — KANBAN VIEW
    ══════════════════════════════════════════════════════ -->
    <record id="asset_request_view_kanban" model="ir.ui.view">
        <field name="name">asset.request.view.kanban</field>
        <field name="model">asset.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false"
                    class="o_kanban_small_column">
                <field name="name"/>
                <field name="requester_id"/>
                <field name="asset_category_id"/>
                <field name="state"/>
                <field name="priority"/>
                <field name="availability_status"/>
                <field name="required_date"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <t t-esc="record.name.value"/>
                                    </strong>
                                    <small class="o_kanban_record_subtitle text-muted">
                                        <t t-esc="record.asset_category_id.value"/>
                                    </small>
                                </div>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><i class="fa fa-user me-1"/><t t-esc="record.requester_id.value"/></div>
                                <div class="mt-1"><i class="fa fa-calendar me-1"/>
                                    Due: <t t-esc="record.required_date.value"/>
                                </div>
                                <div class="mt-1">
                                    <field name="availability_status" widget="label_selection"
                                           options="{'classes': {'available': 'success', 'not_available': 'danger', 'unknown': 'warning'}}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════
         ASSET REQUEST — SEARCH VIEW
    ══════════════════════════════════════════════════════ -->
    <record id="asset_request_view_search" model="ir.ui.view">
        <field name="name">asset.request.view.search</field>
        <field name="model">asset.request</field>
        <field name="arch" type="xml">
            <search string="Search Asset Requests">
                <field name="name"/>
                <field name="requester_id"/>
                <field name="asset_category_id"/>
                <field name="department_id"/>
                <filter string="My Requests" name="my_requests"
                        domain="[('requester_id','=',uid)]"/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state','=','submitted')]"/>
                <filter string="Pending Purchase" name="pending_purchase"
                        domain="[('state','=','pending_purchase')]"/>
                <filter string="Fulfilled" name="fulfilled" domain="[('state','=','fulfilled')]"/>
                <filter string="Rejected" name="rejected" domain="[('state','=','rejected')]"/>
                <separator/>
                <filter string="Asset Not Available" name="unavailable"
                        domain="[('availability_status','=','not_available')]"/>
                <group expand="0" string="Group By">
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Category" name="group_category" context="{'group_by': 'asset_category_id'}"/>
                    <filter string="Department" name="group_dept" context="{'group_by': 'department_id'}"/>
                    <filter string="Requester" name="group_requester" context="{'group_by': 'requester_id'}"/>
                    <filter string="Priority" name="group_priority" context="{'group_by': 'priority'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════
         ASSET REQUEST — ACTIONS
    ══════════════════════════════════════════════════════ -->
    <record id="action_asset_request" model="ir.actions.act_window">
        <field name="name">Asset Requests</field>
        <field name="res_model">asset.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_my_requests': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Raise your first asset request</p>
            <p>Staff and faculty can request assets here. The system checks
               availability and routes to the IT helpdesk automatically.</p>
        </field>
    </record>

</odoo>