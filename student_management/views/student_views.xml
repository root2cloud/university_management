<odoo>
    <record id="view_student_form" model="ir.ui.view">
        <field name="name">student.form</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                    <field name="age"/>
                    <field name="email"/>
                    <field name="teacher_id"/>
                    <field name="hobby_ids" widget="many2many_tags"/>
                </group>

                <group>
                    <field name="mark_ids">
                        <tree editable="bottom">
                            <field name="subject"/>
                            <field name="marks"/>
                        </tree>
                    </field>
                </group>

                <group>
                    <field name="total_marks" readonly="1"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_student_tree" model="ir.ui.view">
        <field name="name">student.tree</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="age"/>
                <field name="total_marks"/>
            </tree>
        </field>
    </record>

    <menuitem id="menu_root" name="Student Management"/>
    <menuitem id="menu_student" name="Students" parent="menu_root"/>
    <menuitem id="menu_student_students" name="Student Records"
              parent="menu_student" action="student_action"/>

    <record id="student_action" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">student.student</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
