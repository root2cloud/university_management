<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_library_borrowing_form" model="ir.ui.view">
        <field name="name">library.borrowing.form</field>
        <field name="model">library.borrowing</field>
        <field name="arch" type="xml">
            <form string="Borrowing">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="completion_sequence" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="borrower_id"/>
                            <field name="book_id"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="borrow_date"/>
                            <field name="return_date"/>
                        </group>
                    </group>
                    <group string="Reservation Details">
                        <field name="reservation_date" required="status == 'reserved'"/>
                        <field name="expiry_date" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_library_borrowing_list" model="ir.ui.view">
        <field name="name">library.borrowing.list</field>
        <field name="model">library.borrowing</field>
        <field name="arch" type="xml">
            <list string="Borrowings">
                <field name="completion_sequence"/>
                <field name="borrower_id"/>
                <field name="book_id"/>
                <field name="status"/>
                <field name="borrow_date"/>
                <field name="return_date"/>
                <field name="reservation_date"/>
                <field name="expiry_date"/>
            </list>
        </field>
    </record>

    <record id="action_library_borrowing" model="ir.actions.act_window">
        <field name="name">Borrowings</field>
        <field name="res_model">library.borrowing</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_library_borrowing" name="Borrowings" parent="main_menu_root" action="action_library_borrowing"/>
</odoo>