<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_library_member_list" model="ir.ui.view">
        <field name="name">library.member.list</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_library_member_form" model="ir.ui.view">
        <field name="name">library.member.form</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="email"/>
                        <field name="phone"/>
                        <field name="membership_start_date"/>
                        <field name="membership_end_date"/>
                        <field name="status"/>
                    </group>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_borrowings" string="Current Borrowings"
                                class="oe_stat_button" icon="fa-book"/>
                        <button type="object" name="action_view_reservations" string="Reservations"
                                class="oe_stat_button" icon="fa-calendar"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_library_member" model="ir.actions.act_window">
        <field name="name">Members</field>
        <field name="res_model">library.member</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_library_member" name="Members" parent="main_menu_root" action="action_library_member"/>
</odoo>