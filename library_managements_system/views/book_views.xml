<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_library_book_list" model="ir.ui.view">
        <field name="name">library.book.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list>
                <field name="title"/>
                <field name="isbn"/>
                <field name="author_id"/>
                <field name="available_copies"/>
                <field name="category_id"/>
            </list>
        </field>
    </record>

    <record id="view_library_book_form" model="ir.ui.view">
        <field name="name">library.book.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="title"/>
                        <field name="isbn"/>
                        <field name="author_id"/>
                        <field name="category_id"/>
                        <field name="published_date"/>
                        <field name="available_copies"/>
                        <field name="description" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_library_book" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="main_menu_root" name="Library Management System"/>

    <menuitem id="menu_library_book" name="Books" parent="main_menu_root" action="action_library_book"/>
</odoo>