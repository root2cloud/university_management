<odoo>
    <record id="design_service_request_form_view" model="ir.ui.view">
        <field name="name">design.service.request.form</field>
        <field name="model">design.service.request</field>
        <field name="arch" type="xml">
            <form string="Service Request">
                <sheet>
                    <group>
                        <field name="project_id" readonly="1"/>
                        <field name="request_date"/>
                        <field name="description"/>
                        <field name="state"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="design_service_request_list_view" model="ir.ui.view">
        <field name="name">design.service.request.list</field>
        <field name="model">design.service.request</field>
        <field name="arch" type="xml">
            <list string="Service Requests">
                <field name="project_id"/>
                <field name="request_date"/>
                <field name="description"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="action_design_service_request" model="ir.actions.act_window">
        <field name="name">Service Requests</field>
        <field name="res_model">design.service.request</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_design_service_request" name="Service Requests" parent="main_menu_root"
              action="action_design_service_request"/>
</odoo>